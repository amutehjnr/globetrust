<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Portal' %> · Globe Trust Bank</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/support.css">
  <link rel="stylesheet" href="/css/portal.css">
  <link rel="stylesheet" href="/css/settings.css">
  <link rel="stylesheet" href="/css/accounts.css">
  <link rel="stylesheet" href="/css/beneficiaries.css">
  <link rel="stylesheet" href="/css/cards.css">
  <link rel="stylesheet" href="/css/exchange-rates.css">
</head>
<body class="db-body">
<div class="db-shell">
  <%- include('customer-nav') %>
  <div class="db-main">
    <header class="db-topbar">
      <div class="db-search">
        <span class="db-search__icon" aria-hidden="true">⌕</span>
        <input type="search" placeholder="Search transactions, payees, or services..." aria-label="Search">
      </div>
      <div class="db-topbar__right">
        <button type="button" class="db-icon-btn" aria-label="Notifications">🔔</button>
        <a href="/app/profile" class="db-user-photo" title="Profile">
          <% if (typeof profile !== 'undefined' && profile && profile.profilePhotoUrl) { %>
            <img src="<%= profile.profilePhotoUrl %>" alt="" width="42" height="42" loading="lazy" decoding="async">
          <% } else { %>
            <span class="db-user-photo__empty" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.5 20.25a8.25 8.25 0 0115 0" />
              </svg>
            </span>
          <% } %>
        </a>
        <div class="db-translator" id="db-translator">
          <label class="db-translator__label" for="db-language">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8M12 3c2.5 3 4 6 4 9s-1.5 6-4 9c-2.5-3-4-6-4-9s1.5-6 4-9z" />
            </svg>
          </label>
          <select id="db-language" class="db-translator__select" aria-label="Translate page" data-csrf="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>
            <% var loc = (typeof profile !== \'undefined\' && profile && profile.preferredLocale) ? profile.preferredLocale : (typeof preferredLocale !== \'undefined\' ? preferredLocale : \'en\'); %>
              <option value="en" <%= loc === 'en' ? 'selected' : '' %>>English</option>
              <option value="fr" <%= loc === 'fr' ? 'selected' : '' %>>Français</option>
              <option value="es" <%= loc === 'es' ? 'selected' : '' %>>Español</option>
              <option value="pt" <%= loc === 'pt' ? 'selected' : '' %>>Português</option>
              <option value="de" <%= loc === 'de' ? 'selected' : '' %>>Deutsch</option>
              <option value="it" <%= loc === 'it' ? 'selected' : '' %>>Italiano</option>
              <option value="nl" <%= loc === 'nl' ? 'selected' : '' %>>Nederlands</option>
              <option value="ru" <%= loc === 'ru' ? 'selected' : '' %>>Русский</option>
              <option value="zh-CN" <%= loc === 'zh-CN' || loc === 'zh' ? 'selected' : '' %>>中文 (简体)</option>
              <option value="zh-TW" <%= loc === 'zh-TW' ? 'selected' : '' %>>中文 (繁體)</option>
              <option value="ja" <%= loc === 'ja' ? 'selected' : '' %>>日本語</option>
              <option value="ko" <%= loc === 'ko' ? 'selected' : '' %>>한국어</option>
              <option value="ar" <%= loc === 'ar' ? 'selected' : '' %>>العربية</option>
              <option value="hi" <%= loc === 'hi' ? 'selected' : '' %>>हिन्दी</option>
              <option value="bn" <%= loc === 'bn' ? 'selected' : '' %>>বাংলা</option>
              <option value="tr" <%= loc === 'tr' ? 'selected' : '' %>>Türkçe</option>
              <option value="pl" <%= loc === 'pl' ? 'selected' : '' %>>Polski</option>
              <option value="vi" <%= loc === 'vi' ? 'selected' : '' %>>Tiếng Việt</option>
              <option value="th" <%= loc === 'th' ? 'selected' : '' %>>ไทย</option>
              <option value="id" <%= loc === 'id' ? 'selected' : '' %>>Bahasa Indonesia</option>
              <option value="ms" <%= loc === 'ms' ? 'selected' : '' %>>Bahasa Melayu</option>
              <option value="sv" <%= loc === 'sv' ? 'selected' : '' %>>Svenska</option>
              <option value="da" <%= loc === 'da' ? 'selected' : '' %>>Dansk</option>
              <option value="fi" <%= loc === 'fi' ? 'selected' : '' %>>Suomi</option>
              <option value="no" <%= loc === 'no' ? 'selected' : '' %>>Norsk</option>
              <option value="cs" <%= loc === 'cs' ? 'selected' : '' %>>Čeština</option>
              <option value="ro" <%= loc === 'ro' ? 'selected' : '' %>>Română</option>
              <option value="hu" <%= loc === 'hu' ? 'selected' : '' %>>Magyar</option>
              <option value="el" <%= loc === 'el' ? 'selected' : '' %>>Ελληνικά</option>
              <option value="he" <%= loc === 'he' ? 'selected' : '' %>>עברית</option>
              <option value="uk" <%= loc === 'uk' ? 'selected' : '' %>>Українська</option>
              <option value="fa" <%= loc === 'fa' ? 'selected' : '' %>>فارسی</option>
              <option value="ur" <%= loc === 'ur' ? 'selected' : '' %>>اردو</option>
              <option value="ta" <%= loc === 'ta' ? 'selected' : '' %>>தமிழ்</option>
              <option value="tl" <%= loc === 'tl' ? 'selected' : '' %>>Filipino</option>
              <option value="ca" <%= loc === 'ca' ? 'selected' : '' %>>Català</option>
          </select>
        </div>
        <div id="google_translate_element" class="db-translator__google" hidden></div>
      </div>
    </header>
    <div class="db-content">