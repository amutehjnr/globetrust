<!-- Mobile hamburger -->
<button
  type="button"
  class="db-hamburger"
  aria-label="Open navigation menu"
  aria-controls="db-sidebar"
  aria-expanded="false"
>
  <span aria-hidden="true">☰</span>
</button>

<!-- Mobile backdrop -->
<button
  type="button"
  class="db-sidebar-backdrop"
  aria-label="Close navigation menu"
  aria-hidden="true"
  tabindex="-1"
></button>

<!-- Sidebar -->
<aside class="db-sidebar" aria-label="Admin navigation">
  <a class="db-sidebar__brand" href="/admin">
    <span class="db-sidebar__logo" aria-hidden="true">
      <svg viewBox="0 0 32 32" width="28" height="28" fill="none">
        <circle cx="16" cy="16" r="14" stroke="#c5a15b" stroke-width="1.5"/>
        <ellipse cx="16" cy="16" rx="6" ry="14" stroke="#c5a15b" stroke-width="1.2"/>
        <path d="M2 16h28M16 2c4 4 6 9 6 14s-2 10-6 14c-4-4-6-9-6-14s2-10 6-14z" stroke="#c5a15b" stroke-width="1.2"/>
      </svg>
    </span>
    <span>
      <strong>GLOBE TRUST</strong>
      <small>ADMIN</small>
    </span>
  </a>

  <nav class="db-sidebar__nav">
    <a href="/admin" class="db-nav-item<%= path === '/admin' ? ' is-active' : '' %>">
      <span class="db-nav-icon">⌂</span> Overview
    </a>
    <a href="/admin/customers" class="db-nav-item<%= path === '/admin/customers' ? ' is-active' : '' %>">
      <span class="db-nav-icon">▤</span> Customers
    </a>
    <a href="/admin/customers/new" class="db-nav-item">
      <span class="db-nav-icon">＋</span> Create account
    </a>
    <a href="/admin/transfers" class="db-nav-item<%= path === '/admin/transfers' ? ' is-active' : '' %>">
      <span class="db-nav-icon">⇄</span> Transfers
    </a>
    <a href="/admin/kyc" class="db-nav-item<%= path === '/admin/kyc' ? ' is-active' : '' %>">
      <span class="db-nav-icon">☰</span> KYC queue
    </a>
    <a href="/admin/kyc/atm" class="db-nav-item<%= path === '/admin/kyc/atm' ? ' is-active' : '' %>">
      <span class="db-nav-icon">▤</span> ATM cards
    </a>
    <a href="/admin/approvals" class="db-nav-item<%= path === '/admin/approvals' ? ' is-active' : '' %>">
      <span class="db-nav-icon">✓</span> Approvals
    </a>
    <a href="/admin/staff" class="db-nav-item<%= path === '/admin/staff' ? ' is-active' : '' %>">
      <span class="db-nav-icon">👤</span> Staff
    </a>
    <a href="/admin/reports" class="db-nav-item<%= path === '/admin/reports' ? ' is-active' : '' %>">
      <span class="db-nav-icon">▣</span> Reports
    </a>
    <a href="/admin/support" class="db-nav-item<%= path === '/admin/support' ? ' is-active' : '' %>">
      <span class="db-nav-icon">◇</span> Support inbox
    </a>
    <a href="/admin/audit" class="db-nav-item<%= path === '/admin/audit' ? ' is-active' : '' %>">
      <span class="db-nav-icon">◎</span> Audit log
    </a>
  </nav>

  <div class="db-sidebar__foot">
    <a href="/dashboard" class="db-nav-item">Customer view</a>
    <form method="post" action="/sign-out" class="db-signout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit">Sign out</button>
    </form>
  </div>
</aside>

<script src="/js/admin-sidebar.js" defer></script>