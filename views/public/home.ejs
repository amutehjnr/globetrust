<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f5f0e7">
  <meta name="description" content="Discover personal banking, business banking and global financial services with GLOBE TRUST BANK.">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'GLOBE TRUST BANK | Global Banking for a Brighter Tomorrow' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r160/three.min.js"></script>
  <script defer src="/js/site.js"></script>
  <link rel="stylesheet" href="/css/carousel.css">
  <link rel="stylesheet" href="/css/flags-watermark.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main id="main">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> BANKING WITHOUT BORDERS</p>
        <h1 id="hero-title">Global Banking<br>for a Brighter<br><em>Tomorrow</em></h1>
        <p class="hero-description">At Globe Trust Bank, we connect you to a world of opportunities. Secure, innovative and global banking solutions for individuals and businesses, anywhere in the world.</p>
        <div class="hero-actions">
          <a class="button button-gold" href="/open-account">Open an Account <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href="#services">Explore Our Services</a>
        </div>
        <div class="hero-trust"><span class="trust-icon">✓</span><span>Secure by design</span><span class="trust-dot">·</span><span>Built around you</span></div>
      </div>

      <div class="hero-art" aria-label="Decorative 3D globe and premium bank card">
        <div class="marble-orb orb-one"></div><div class="marble-orb orb-two"></div>
        <div class="orbit orbit-a"></div><div class="orbit orbit-b"></div><div class="orbit orbit-c"></div>
        <div class="currency currency-usd">$</div><div class="currency currency-eur">€</div><div class="currency currency-yen">¥</div><div class="currency currency-pound">£</div>
        <div id="globe-stage" class="globe-stage"><div class="globe-fallback"><span>G</span></div></div>
        <div class="globe-caption"><span class="live-dot"></span> CONNECTED ACROSS THE WORLD</div>
        <div class="bank-card" aria-label="Illustration of a Globe Trust Bank payment card">
          <div class="card-top"><span class="mini-emblem">◎</span><span>GLOBE TRUST BANK</span><span class="card-contactless">)))</span></div>
          <div class="card-chip"><span></span><span></span><span></span><span></span></div>
          <div class="card-number">•••• &nbsp; •••• &nbsp; •••• &nbsp; 3456</div>
          <div class="card-bottom"><span>YOUR NAME</span><strong>VISA</strong></div>
        </div>
        <div class="art-base"></div>
        <div class="art-spark spark-one">✦</div><div class="art-spark spark-two">✧</div>
      </div>

      <div class="hero-bottom">
        <a class="hero-feature" href="#personal"><span class="feature-icon">♙</span><span><strong>Personal Banking</strong><small>Grow your wealth</small></span><b>↗</b></a>
        <a class="hero-feature" href="#business"><span class="feature-icon">▥</span><span><strong>Business Banking</strong><small>Power your business</small></span><b>↗</b></a>
        <a class="hero-feature" href="#global"><span class="feature-icon">◎</span><span><strong>Global Transfers</strong><small>Send worldwide</small></span><b>↗</b></a>
        <a class="hero-feature" href="#security"><span class="feature-icon">♢</span><span><strong>Secure &amp; Trusted</strong><small>Your security matters</small></span><b>↗</b></a>
      </div>
    </section>

    <section class="services-section section-shell" id="services">
      <div class="section-heading">
  <div>
    <p class="eyebrow">BANKING, REIMAGINED</p>
    <h2>Everything you need.<br><em>All in one place.</em></h2>
  </div>

