<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>About Us | Globe Trust Bank</title>
  <meta name="description" content="Learn about Globe Trust Bank's vision, values, and approach to modern banking.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/About.css">
</head>

<body>
  <%- include('../partials/header') %>

  <main>

    <!-- ========== HERO: WHO WE ARE ========== -->
    <section class="about-hero">
      <div class="container">
        <div class="about-hero-grid">
          <div class="about-hero-copy">
            <span class="eyebrow">Who we are</span>
            <h1 class="display">Banking with purpose.<br><em>Built around you.</em></h1>
            <p class="lead">
              At Globe Trust Bank, our vision is to create a thoughtful,
              customer-focused banking experience built around trust,
              responsible innovation, and dependable service.
            </p>
            <a href="/contact" class="btn btn-gold">Speak with our team →</a>
          </div>
          <div class="about-hero-photo">
            <img
              src="/images/about-hero.jpg"
              alt="Globe Trust Bank headquarters"
              width="720" height="540"
              loading="eager"
              decoding="async"
            >
            <div class="about-hero-photo-caption">
              <span>EST. 1952</span>
              <strong>Lagos · London · New York</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== OUR STORY ========== -->
    <section class="about-section about-section-light">
      <div class="container">
        <div class="split-content">
          <div class="split-label">
            <span class="eyebrow">Our story</span>
            <h2 class="display-md">
              A considered<br>approach to<br><em>modern banking.</em>
            </h2>
          </div>
          <div class="split-body">
            <p class="lead">
              We believe banking should feel clear, accessible, and connected
              to the needs of the people it serves.
            </p>
            <p>
              Our approach combines thoughtful service with a digital experience
              designed to make financial information easier to navigate.
            </p>
            <p>
              We are building our public digital presence around simplicity,
              customer care, and responsible technology — with banking services
              introduced through appropriate bank-approved integrations.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== OUR VALUES (DARK SECTION) ========== -->
    <section class="about-section about-section-dark">
      <div class="container">
        <div class="section-intro">
          <span class="eyebrow eyebrow-light">What guides us</span>
          <h2 class="display-md">The principles behind<br><em>our approach.</em></h2>
        </div>

        <div class="values-row">
          <article class="value-block">
            <div class="value-number">01</div>
            <h3>Trust and integrity</h3>
            <p>We value transparency, responsible decisions, and respectful
              relationships with every customer we serve.</p>
          </article>

          <article class="value-block">
            <div class="value-number">02</div>
            <h3>People first</h3>
            <p>We aim to make every interaction clear, approachable, and
              focused on real customer needs.</p>
          </article>

          <article class="value-block">
            <div class="value-number">03</div>
            <h3>Thoughtful innovation</h3>
            <p>We see technology as a way to create more convenient and
              accessible banking experiences.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== THE EXPERIENCE ========== -->
    <section class="about-section about-section-light">
      <div class="container">
        <div class="split-content split-content-reverse">
          <div class="split-label">
            <span class="eyebrow">The experience</span>
            <h2 class="display-md">
              Modern in approach.<br><em>Personal in spirit.</em>
            </h2>
          </div>
          <div class="split-body">
            <p class="lead">
              Our digital experience is being designed to provide clear
              information, convenient access across devices, and straightforward
              ways to connect with support.
            </p>
            <p>
              Security, privacy, accessibility, and dependable service are
              important considerations in the development of our platform.
              We measure quality not just in uptime, but in how reassuring
              the experience feels to the people using it.
            </p>
            <a href="/contact" class="btn btn-outline">Get in touch →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== CONTACT CTA (GOLD BAND) ========== -->
    <section class="about-cta">
      <div class="container">
        <div class="about-cta-inner">
          <span class="eyebrow">Let's connect</span>
          <h2 class="display-md">
            Every good relationship starts<br>with a <em>conversation.</em>
          </h2>
          <p>
            Have a question or want to learn more about Globe Trust Bank?
            Get in touch with our team.
          </p>
          <div class="about-cta-actions">
            <a href="/contact" class="btn btn-navy">Contact us →</a>
            <a href="/" class="btn btn-ghost">Return home</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('../partials/footer') %>
  <script defer src="/js/site.js"></script>
</body>
</html>