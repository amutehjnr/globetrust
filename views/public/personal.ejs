<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Personal banking · Globe Trust Bank</title>
  <meta name="description" content="Personal accounts, cards, and everyday banking from Globe Trust Bank. Clear rates, real support, seven years of statements.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/personal.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main>

    <!-- ========== HERO ========== -->
    <section class="about-hero">
      <div class="container">
        <div class="about-hero-grid">
          <div class="about-hero-copy">
            <span class="eyebrow">Personal banking</span>
            <h1 class="display">
              Your money,<br><em>at your pace.</em>
            </h1>
            <p class="lead">
              Current and savings accounts, card controls, and instant transfers
              between your own accounts. Statements go back seven years.
              Everything you'd do at a counter, without the queue.
            </p>
            <div class="hero-actions" style="margin-top: 2rem; display: flex; gap: 0.85rem; flex-wrap: wrap;">
              <a href="/register" class="btn btn-gold">Open an account →</a>
              <a href="#accounts" class="btn btn-outline">Compare accounts</a>
            </div>
          </div>
          <div class="about-hero-photo">
            <img
              src="/images/personal-hero.jpg"
              alt="Globe Trust Bank personal banking"
              width="720" height="540"
              loading="eager"
              decoding="async"
            >
            <div class="about-hero-photo-caption">
              <span>PERSONAL BANKING</span>
              <strong>Current · Savings · Cards</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== ACCOUNT TYPES ========== -->
    <section class="about-section about-section-light" id="accounts" style="padding-top: 2rem;">
      <div class="container">
        <div class="section-intro" style="max-width: 720px; margin-inline: auto; text-align: center; margin-bottom: 3.5rem;">
          <span class="eyebrow">Choose your account</span>
          <h2 class="display-md">
            Three accounts,<br><em>one relationship.</em>
          </h2>
          <p class="lead" style="margin-top: 1.25rem; color: var(--text-muted);">
            Pick the account that matches where you are today. You can add
            others later — or hold all three.
          </p>
        </div>

        <div class="account-grid">
          <!-- Current Account -->
          <article class="account-card">
            <div class="account-badge">Most popular</div>
            <h3>Current account</h3>
            <p class="account-desc">
              Day-to-day banking. Debit card, direct debits, standing orders,
              and instant transfers between your own accounts.
            </p>
            <div class="account-rate">
              <span class="rate-value">0.00%</span>
              <span class="rate-label">monthly maintenance fee</span>
            </div>
            <ul class="account-features">
              <li>Free debit card</li>
              <li>Instant transfers between your accounts</li>
              <li>Standing orders & direct debits</li>
              <li>Mobile & web banking</li>
              <li>7-year statement history</li>
            </ul>
            <a href="/register?type=current" class="btn btn-gold btn-block">Open current account</a>
          </article>

          <!-- Savings Account -->
          <article class="account-card account-card-featured">
            <div class="account-badge account-badge-gold">Best for growth</div>
            <h3>Savings account</h3>
            <p class="account-desc">
              Put money aside and watch it grow. Competitive interest, no
              lock-in, withdraw anytime.
            </p>
            <div class="account-rate">
              <span class="rate-value">4.25%</span>
              <span class="rate-label">AER variable</span>
            </div>
            <ul class="account-features">
              <li>No minimum balance</li>
              <li>Withdraw anytime — no penalties</li>
              <li>Interest paid monthly</li>
              <li>Automatic top-ups from your current account</li>
              <li>Savings goals & progress tracking</li>
            </ul>
            <a href="/register?type=savings" class="btn btn-gold btn-block">Open savings account</a>
          </article>

          <!-- Fixed Deposit -->
          <article class="account-card">
            <h3>Fixed deposit</h3>
            <p class="account-desc">
              Lock money away for a set term and earn a higher rate. For
              money you don't need to touch for a while.
            </p>
            <div class="account-rate">
              <span class="rate-value">6.50%</span>
              <span class="rate-label">AER fixed · 12 months</span>
            </div>
            <ul class="account-features">
              <li>Terms from 3 to 36 months</li>
              <li>Rate fixed for the whole term</li>
              <li>Interest paid at maturity</li>
              <li>Auto-renew available</li>
              <li>Early access available (with notice)</li>
            </ul>
            <a href="/register?type=fixed" class="btn btn-outline btn-block">Open fixed deposit</a>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== EVERYDAY FEATURES ========== -->
    <section class="about-section about-section-dark">
      <div class="container">
        <div class="section-intro" style="max-width: 640px; margin-bottom: 3.5rem;">
          <span class="eyebrow eyebrow-light">Everyday features</span>
          <h2 class="display-md">
            What you can<br><em>actually do.</em>
          </h2>
          <p class="lead" style="color: rgba(255,255,255,0.7); margin-top: 1rem;">
            No fine print, no surprises. These are the six things people
            use most.
          </p>
        </div>

        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
              </svg>
            </div>
            <h4>Card controls</h4>
            <p>Freeze, unfreeze, and set spending limits from your phone — in seconds.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
              </svg>
            </div>
            <h4>Instant transfers</h4>
            <p>Move money between your own accounts immediately. No waiting, no fees.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
              </svg>
            </div>
            <h4>Statements, 7 years</h4>
            <p>Download any statement from the last seven years, anytime, as PDF or CSV.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
            </div>
            <h4>Two-step verification</h4>
            <p>Every sign-in requires a code. Your password alone is never enough.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
              </svg>
            </div>
            <h4>Mobile app</h4>
            <p>Full banking from your phone. Available on iOS and Android.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
              </svg>
            </div>
            <h4>Support by phone</h4>
            <p>The number is on your card. Real people, no automated mazes.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== RATES & FEES ========== -->
    <section class="about-section about-section-light">
      <div class="container">
        <div class="split-content">
          <div class="split-label">
            <span class="eyebrow">Rates & fees</span>
            <h2 class="display-md">
              Clear numbers,<br><em>no surprises.</em>
            </h2>
          </div>
          <div class="split-body">
            <p class="lead">
              Here are the numbers that matter. Everything else — overdraft
              rates, foreign transaction fees, card replacement — is listed
              in the full fee schedule.
            </p>

            <div class="rates-table">
              <div class="rate-row">
                <div class="rate-row-label">
                  <strong>Savings AER</strong>
                  <span>Variable, paid monthly</span>
                </div>
                <div class="rate-row-value">4.25%</div>
              </div>
              <div class="rate-row">
                <div class="rate-row-label">
                  <strong>Fixed deposit AER</strong>
                  <span>12-month term</span>
                </div>
                <div class="rate-row-value">6.50%</div>
              </div>
              <div class="rate-row">
                <div class="rate-row-label">
                  <strong>Monthly maintenance</strong>
                  <span>Current & savings accounts</span>
                </div>
                <div class="rate-row-value">£0.00</div>
              </div>
              <div class="rate-row">
                <div class="rate-row-label">
                  <strong>Card replacement</strong>
                  <span>Standard delivery</span>
                </div>
                <div class="rate-row-value">£0.00</div>
              </div>
              <div class="rate-row">
                <div class="rate-row-label">
                  <strong>Instant transfers</strong>
                  <span>Between your own accounts</span>
                </div>
                <div class="rate-row-value">£0.00</div>
              </div>
            </div>

            <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 1.25rem;">
              Rates shown are correct as of <strong><%= typeof currentYear !== 'undefined' ? currentYear : new Date().getFullYear() %></strong>.
              Full fee schedule available on request.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========== CTA ========== -->
    <section class="about-cta">
      <div class="container">
        <div class="about-cta-inner">
          <span class="eyebrow">Ready when you are</span>
          <h2 class="display-md">
            Open an account<br><em>in minutes.</em>
          </h2>
          <p>
            No paperwork to post. No branch visit required. Just the details
            you already know, and about five minutes.
          </p>
          <div class="about-cta-actions">
            <a href="/register" class="btn btn-navy">Open an account →</a>
            <a href="/contact" class="btn btn-ghost">Speak to someone</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('../partials/footer') %>
  <script defer src="/js/site.js"></script>
</body>
</html>