<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Contact and support · Globe Trust Bank</title>
  <meta name="description" content="Reach Globe Trust Bank support by phone, email, or at a branch. We will never ask for your password or full card number.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/contact.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main>

    <!-- ========== HERO ========== -->
    <section class="about-hero">
      <div class="container">
        <div class="about-hero-copy" style="max-width: 720px; margin: 0 auto; text-align: center;">
          <span class="eyebrow">Contact & support</span>
          <h1 class="display">
            Talk to <em>a person.</em>
          </h1>
          <p class="lead">
            Reach our official support channels. We will never ask for your
            password or full card number — if someone does, it isn't us.
          </p>
        </div>
      </div>
    </section>

    <!-- ========== CONTACT METHODS ========== -->
    <section class="about-section about-section-light" style="padding-top: 2rem;">
      <div class="container">
        <div class="contact-methods">
          <article class="contact-card">
            <div class="contact-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
            </div>
            <h3>Call us</h3>
            <p>Speak to a support specialist. The number is on the back of your card, or use the one below.</p>
            <a href="tel:+2341234567890" class="contact-link">+234 123 456 7890</a>
            <span class="contact-meta">Mon–Fri · 8am–8pm</span>
          </article>

          <article class="contact-card">
            <div class="contact-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <h3>Email us</h3>
            <p>For non-urgent questions, write to our support team and we'll respond within one business day.</p>
            <a href="mailto:support@globetrust.com" class="contact-link">support@globetrust.com</a>
            <span class="contact-meta">Response within 1 business day</span>
          </article>

          <article class="contact-card">
            <div class="contact-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <h3>Visit a branch</h3>
            <p>Prefer to speak to someone in person? Every branch has a dedicated customer service desk.</p>
            <a href="/branch" class="contact-link">Find your nearest branch</a>
            <span class="contact-meta">Mon–Fri · 9am–5pm</span>
          </article>
        </div>
      </div>
    </section>

    <!-- ========== CONTACT FORM + SECURITY NOTE ========== -->
    <section class="about-section about-section-light" style="padding-top: 0;">
      <div class="container">
        <div class="contact-form-grid">

          <!-- LEFT: Form -->
          <div class="contact-form-wrap">
            <span class="eyebrow">Or send a message</span>
            <h2 class="display-md" style="margin-bottom: 1.5rem;">
              Tell us what<br><em>you need.</em>
            </h2>
            <p style="color: var(--text-muted); margin-bottom: 2rem; font-size: 1rem; line-height: 1.65;">
              Fill in the form below and we'll be in touch. For urgent matters,
              please call us directly.
            </p>

            <% if (typeof error !== 'undefined' && error) { %>
              <div class="form-alert form-alert-error"><%= error %></div>
            <% } %>
            <% if (typeof success !== 'undefined' && success) { %>
              <div class="form-alert form-alert-success"><%= success %></div>
            <% } %>

            <form method="POST" action="/contact" class="contact-form" novalidate>
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

              <div class="form-row">
                <div class="form-group">
                  <label for="name">Your name</label>
                  <input type="text" id="name" name="name" required autocomplete="name"
                         value="<%= typeof form !== 'undefined' && form.name ? form.name : '' %>">
                </div>
                <div class="form-group">
                  <label for="email">Email address</label>
                  <input type="email" id="email" name="email" required autocomplete="email"
                         value="<%= typeof form !== 'undefined' && form.email ? form.email : '' %>">
                </div>
              </div>

              <div class="form-group">
                <label for="subject">What is this about?</label>
                <select id="subject" name="subject" required>
                  <option value="">Choose a topic…</option>
                  <option value="account">Account questions</option>
                  <option value="cards">Cards & payments</option>
                  <option value="business">Business banking</option>
                  <option value="security">Security concern</option>
                  <option value="other">Something else</option>
                </select>
              </div>

              <div class="form-group">
                <label for="message">Your message</label>
                <textarea id="message" name="message" rows="5" required><%= typeof form !== 'undefined' && form.message ? form.message : '' %></textarea>
              </div>

              <button type="submit" class="btn btn-gold">Send message →</button>
            </form>
          </div>

          <!-- RIGHT: Security note -->
          <aside class="security-note">
            <div class="security-note-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
            </div>
            <h3>What we will never ask</h3>
            <ul class="security-list">
              <li>Your password</li>
              <li>Your full card number</li>
              <li>A one-time code sent to your phone</li>
              <li>For money to be moved to a "safe account"</li>
            </ul>
            <p class="security-footer">
              If someone contacts you asking for any of these, hang up and call
              the number on the back of your card immediately.
            </p>

            <div class="security-divider"></div>

            <h3 style="font-size: 1.05rem; margin-bottom: 0.75rem;">Report fraud</h3>
            <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1rem;">
              If you suspect fraud on your account, please call us immediately.
              We are available 24/7 for fraud reports.
            </p>
            <a href="tel:+15234567890" class="btn btn-outline" style="width: 100%; justify-content: center;">
              Report fraud: +1 523 456 7890
            </a>
          </aside>

        </div>
      </div>
    </section>

    <!-- ========== CTA ========== -->
    <section class="about-cta">
      <div class="container">
        <div class="about-cta-inner">
          <span class="eyebrow">Other pages</span>
          <h2 class="display-md">
            Looking for<br><em>something else?</em>
          </h2>
          <p>
            Explore our products and services, or return to the homepage.
          </p>
          <div class="about-cta-actions">
            <a href="/business" class="btn btn-navy">Business banking →</a>
            <a href="/" class="btn btn-ghost">Return home</a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>