<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' && title ? title : 'Something went wrong' %> · Globe Trust Bank</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="description" content="Something went wrong on our side. Please try again shortly.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/error-pages.css">
</head>
<body class="err-page">
  <main class="err-shell">
    <div class="err-container err-container-error">

      <!-- ========== ERROR CODE ========== -->
      <div class="err-code-block">
        <span class="err-code">500</span>
        <span class="err-label">Server error</span>
      </div>

      <!-- ========== COPY ========== -->
      <h1 class="err-title">Something didn't go as planned.</h1>
      <p class="err-lead">
        A temporary issue on our side prevented this page from loading. Our
        team has been notified automatically.
      </p>

      <!-- ========== REASSURANCE ========== -->
      <div class="err-reassure">
        <div class="err-reassure-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
          </svg>
        </div>
        <div class="err-reassure-body">
          <strong>Your data is safe.</strong>
          <p>
            This error didn't affect your account, balances, or any transactions.
            No sensitive details are shown on this page for security reasons.
          </p>
        </div>
      </div>

      <!-- ========== WHAT TO DO ========== -->
      <div class="err-causes">
        <div class="err-cause">
          <div class="err-cause-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
          </div>
          <div>
            <strong>Try again</strong>
            <span>Most temporary issues resolve themselves in a few seconds. Refresh this page or try the action again.</span>
          </div>
        </div>

        <div class="err-cause">
          <div class="err-cause-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
          </div>
          <div>
            <strong>Return home</strong>
            <span>If the error persists, go back to the homepage and try a different route to what you need.</span>
          </div>
        </div>

        <div class="err-cause">
          <div class="err-cause-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
          </div>
          <div>
            <strong>Contact support</strong>
            <span>If this keeps happening, call the number on the back of your card. We can investigate from our side.</span>
          </div>
        </div>
      </div>

      <!-- ========== PRIMARY ACTIONS ========== -->
      <div class="err-actions">
        <a href="/" class="err-btn err-btn-primary">
          Return home
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a href="javascript:location.reload()" class="err-btn err-btn-ghost">
          Try again
        </a>
      </div>

      <!-- ========== FOOTER LINKS ========== -->
      <div class="err-footer">
        <a href="/contact" class="err-footer-link">Contact support</a>
        <span class="err-footer-sep">·</span>
        <a href="/security" class="err-footer-link">Security centre</a>
      </div>

      <!-- ========== BRAND ========== -->
      <div class="err-brand">
        <div class="err-brand-mark">GT</div>
        <span>Globe Trust Bank</span>
      </div>

    </div>
  </main>
</body>
</html>