<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Verify authenticator · Globe Trust Bank</title>
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container page-hero" style="max-width:28rem;">
    <h1>Two-step verification</h1>
    <p class="prose">Enter the 6-digit code from your authenticator app to finish signing in.</p>
    <% if (error) { %><div class="notice" style="border-left-color:#8B3A3A;color:#8B3A3A;"><%= error %></div><% } %>
    <form method="post" action="/mfa/verify" style="margin-top:1.25rem;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label style="display:block;font-weight:600;margin-bottom:0.35rem;">Authentication code</label>
      <input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code"
        style="width:100%;padding:0.7rem;margin-bottom:1rem;border:1px solid #E4E0D8;border-radius:8px;letter-spacing:0.2em;font-size:1.15rem;">
      <button class="btn btn-navy" type="submit" style="width:100%;">Verify</button>
    </form>
    <p class="prose" style="margin-top:1rem;font-size:0.9rem;"><a href="/sign-in">Cancel and return to sign in</a></p>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
