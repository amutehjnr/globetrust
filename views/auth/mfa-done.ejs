<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Authenticator enabled · Globe Trust Bank</title>
  <meta name="description" content="Two-factor authentication is now active on your account.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/mfa-enrolled.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="mfa-done-shell">
    <div class="mfa-done-container">

      <!-- ========== SUCCESS ICON ========== -->
      <div class="mfa-done-icon">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>

      <!-- ========== COPY ========== -->
      <span class="mfa-done-eyebrow">Security step complete</span>
      <h1 class="mfa-done-title">Authenticator enabled.</h1>
      <p class="mfa-done-lead">
        Multi-factor authentication is now active on your portal account.
        Future sign-ins will ask for a code from your authenticator app.
      </p>

      <!-- ========== WHAT'S NOW PROTECTED ========== -->
      <div class="mfa-done-points">
        <div class="mfa-done-point">
          <div class="mfa-done-point-icon mfa-done-point-icon-ok">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          <div>
            <strong>Every sign-in is verified</strong>
            <span>A code from your app confirms it's really you.</span>
          </div>
        </div>

        <div class="mfa-done-point">
          <div class="mfa-done-point-icon mfa-done-point-icon-ok">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          <div>
            <strong>A stolen password isn't enough</strong>
            <span>Even if someone else gets your password, they can't sign in.</span>
          </div>
        </div>

        <div class="mfa-done-point">
          <div class="mfa-done-point-icon mfa-done-point-icon-ok">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          <div>
            <strong>You control which devices</strong>
            <span>Revoke any device from settings if you lose access.</span>
          </div>
        </div>
      </div>

      <!-- ========== PRIMARY CTA ========== -->
      <div class="mfa-done-actions">
        <a href="/app" class="mfa-done-btn-primary">
          Continue to my banking
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <!-- ========== SECONDARY LINKS ========== -->
      <div class="mfa-done-secondary">
        <a href="/mfa/recovery-codes" class="mfa-done-secondary-link">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
          </svg>
          View recovery codes
        </a>
        <span class="mfa-done-secondary-sep">·</span>
        <a href="/security" class="mfa-done-secondary-link">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
          Security centre
        </a>
      </div>

      <!-- ========== HELPFUL NOTE ========== -->
      <div class="mfa-done-note">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
        </svg>
        <span>
          Lost your device? Call the number on the back of your card to
          re-verify your identity. We'll get you back in.
        </span>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>