<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reset password · Globe Trust Bank</title>
  <meta name="description" content="Set a new password for your Globe Trust Bank account.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/reset-password.css">
</head>
<body class="rp-page">
  <%- include('../partials/header') %>

  <main class="rp-shell">

    <!-- ========== LEFT: FORM ========== -->
    <section class="rp-form-panel">
      <div class="rp-form-wrap">

        <span class="rp-eyebrow">Password reset</span>
        <h1 class="rp-title">Set a new password.</h1>
        <p class="rp-lead">
          Choose something strong and unique. You'll sign in with it
          immediately after.
        </p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="rp-alert rp-alert-error">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
            <span><%= error %></span>
          </div>
        <% } %>

        <form method="post" action="/reset-password" class="rp-form" id="rp-form" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="token" value="<%= token %>">

          <!-- New password -->
          <div class="rp-field">
            <label for="rp-password">New password</label>
            <div class="rp-input-wrap">
              <input
                type="password"
                id="rp-password"
                name="password"
                required
                minlength="12"
                autocomplete="new-password"
                placeholder="Create a strong password"
              >
              <button
                type="button"
                class="rp-toggle"
                id="rp-toggle-1"
                aria-label="Show password"
                title="Show/hide password"
              >
                <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="rp-icon-eye">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="rp-icon-eye-off" style="display:none;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Requirements checklist -->
          <ul class="rp-reqs" id="rp-reqs">
            <li data-req="length">
              <span class="rp-req-dot"></span>
              At least 12 characters
            </li>
            <li data-req="upper">
              <span class="rp-req-dot"></span>
              One uppercase letter (A–Z)
            </li>
            <li data-req="lower">
              <span class="rp-req-dot"></span>
              One lowercase letter (a–z)
            </li>
            <li data-req="number">
              <span class="rp-req-dot"></span>
              One number (0–9)
            </li>
          </ul>

          <!-- Confirm password -->
          <div class="rp-field">
            <label for="rp-confirm">Confirm new password</label>
            <div class="rp-input-wrap">
              <input
                type="password"
                id="rp-confirm"
                name="password_confirm"
                required
                minlength="12"
                autocomplete="new-password"
                placeholder="Re-enter your new password"
              >
              <button
                type="button"
                class="rp-toggle"
                id="rp-toggle-2"
                aria-label="Show password"
                title="Show/hide password"
              >
                <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="rp-icon-eye">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" class="rp-icon-eye-off" style="display:none;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                </svg>
              </button>
            </div>
            <span class="rp-match" id="rp-match" aria-live="polite"></span>
          </div>

          <!-- Submit -->
          <button type="submit" class="rp-submit" id="rp-submit">
            Update password
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </button>
        </form>

        <div class="rp-secondary">
          <a href="/sign-in" class="rp-secondary-link">← Back to sign in</a>
        </div>

        <div class="rp-note">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
          </svg>
          <div>
            <strong>This link can only be used once.</strong>
            <span>After updating, all other sessions will be signed out automatically.</span>
          </div>
        </div>

      </div>
    </section>

    <!-- ========== RIGHT: BRAND PANEL ========== -->
    <aside class="rp-brand-panel">
      <div class="rp-brand-inner">
        <div class="rp-brand-mark">GT</div>
        <h2>Globe Trust Bank</h2>
        <p>
          A bank built on unhurried conversation, plain language, and the
          things that actually matter.
        </p>

        <div class="rp-brand-section">
          <h4>What happens next</h4>
          <ol class="rp-steps">
            <li>
              <span class="rp-step-num">01</span>
              <div>
                <strong>Set your password</strong>
                <span>Choose something strong, you'll use it from now on.</span>
              </div>
            </li>
            <li>
              <span class="rp-step-num">02</span>
              <div>
                <strong>Sign in immediately</strong>
                <span>Your new password works right away.</span>
              </div>
            </li>
            <li>
              <span class="rp-step-num">03</span>
              <div>
                <strong>Other sessions end</strong>
                <span>Any device still using the old password is signed out.</span>
              </div>
            </li>
          </ol>
        </div>

        <div class="rp-brand-footer">
          <a href="/security">Security at Globe Trust →</a>
        </div>
      </div>
    </aside>

  </main>

  <%- include('../partials/footer') %>

  <!-- ========== SCRIPT ========== -->
  <script>
    (function () {
      var form = document.getElementById('rp-form');
      if (!form) return;

      var pw = document.getElementById('rp-password');
      var confirm = document.getElementById('rp-confirm');
      var matchMsg = document.getElementById('rp-match');
      var reqs = document.querySelectorAll('#rp-reqs li');
      var submitBtn = document.getElementById('rp-submit');

      /* ---------- Password visibility toggles ---------- */
      function bindToggle(btnId, inputEl) {
        var btn = document.getElementById(btnId);
        if (!btn || !inputEl) return;
        btn.addEventListener('click', function () {
          var visible = inputEl.type === 'text';
          inputEl.type = visible ? 'password' : 'text';
          btn.querySelector('.rp-icon-eye').style.display = visible ? '' : 'none';
          btn.querySelector('.rp-icon-eye-off').style.display = visible ? 'none' : '';
          btn.setAttribute('aria-label', visible ? 'Show password' : 'Hide password');
        });
      }
      bindToggle('rp-toggle-1', pw);
      bindToggle('rp-toggle-2', confirm);

      /* ---------- Requirements checking ---------- */
      function checkRequirements(value) {
        return {
          length: value.length >= 12,
          upper: /[A-Z]/.test(value),
          lower: /[a-z]/.test(value),
          number: /[0-9]/.test(value)
        };
      }

      function updateRequirements() {
        var checks = checkRequirements(pw.value);
        var allPassed = true;
        reqs.forEach(function (li) {
          var key = li.getAttribute('data-req');
          var passed = checks[key];
          if (!passed) allPassed = false;
          li.classList.toggle('is-met', passed);
        });
        return allPassed;
      }

      /* ---------- Match confirmation ---------- */
      function updateMatch() {
        var pwVal = pw.value;
        var cfVal = confirm.value;

        if (!cfVal) {
          matchMsg.textContent = '';
          matchMsg.className = 'rp-match';
          return;
        }

        if (pwVal === cfVal) {
          matchMsg.textContent = '✓ Passwords match';
          matchMsg.className = 'rp-match rp-match-ok';
        } else {
          matchMsg.textContent = '✗ Passwords don\'t match';
          matchMsg.className = 'rp-match rp-match-err';
        }
      }

      /* ---------- Wire up ---------- */
      pw.addEventListener('input', function () {
        updateRequirements();
        updateMatch();
      });

      confirm.addEventListener('input', updateMatch);

      /* ---------- Block submit if mismatched ---------- */
      form.addEventListener('submit', function (e) {
        if (pw.value !== confirm.value) {
          e.preventDefault();
          matchMsg.textContent = '✗ Passwords don\'t match';
          matchMsg.className = 'rp-match rp-match-err';
          confirm.focus();
          return false;
        }
      });

      /* ---------- Init ---------- */
      updateRequirements();
    })();
  </script>
  <script src="/js/reset-password.js" defer></script>
</body>
</html>