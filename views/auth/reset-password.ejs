<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Reset password · Globe Trust Bank</title>
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container page-hero" style="max-width:28rem;">
    <h1>Reset password</h1>
    <% if (error) { %><div class="notice" style="border-left-color:#8B3A3A;"><%= error %></div><% } %>
    <form method="post" action="/reset-password" style="margin-top:1rem;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" value="<%= token %>">
      <label style="display:block;font-weight:600;margin-bottom:0.35rem;">New password</label>
      <input name="password" type="password" required minlength="12" autocomplete="new-password" style="width:100%;padding:0.7rem;margin-bottom:1rem;border:1px solid #E4E0D8;border-radius:8px;">
      <button class="btn btn-navy" type="submit">Update password</button>
    </form>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
