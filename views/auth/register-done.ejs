<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Registration received · Globe Trust Bank</title>
  <meta name="description" content="Your Globe Trust Bank portal profile has been created.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/register-received.css">
</head>
<body>
  <%- include('../partials/header') %>

  <main class="reg-recv-shell">
    <div class="reg-recv-container">

      <!-- ========== ICON ========== -->
      <div class="reg-recv-icon">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
      </div>

      <!-- ========== COPY ========== -->
      <span class="reg-recv-eyebrow">Registration received</span>
      <h1 class="reg-recv-title">Your profile is created.</h1>
      <p class="reg-recv-lead">
        Your portal profile was created successfully. To access your
        dashboard, you'll need to complete two quick steps.
      </p>

      <!-- ========== WHAT'S NEXT ========== -->
      <div class="reg-recv-steps">
        <div class="reg-recv-step">
          <div class="reg-recv-step-num">1</div>
          <div class="reg-recv-step-body">
            <strong>Verify your email address</strong>
            <span>Check your inbox for a verification link. It expires in 24 hours.</span>
          </div>
        </div>

        <div class="reg-recv-step">
          <div class="reg-recv-step-num">2</div>
          <div class="reg-recv-step-body">
            <strong>Set up two-factor authentication</strong>
            <span>Add an authenticator app for a second layer of protection.</span>
          </div>
        </div>
      </div>

      <!-- ========== COMPLIANCE NOTE ========== -->
      <div class="reg-recv-note">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
        </svg>
        <span>
          Banking products (accounts, cards, transfers) remain subject to
          the bank's eligibility and compliance checks, including KYC
          verification.
        </span>
      </div>

      <!-- ========== CTA ========== -->
      <div class="reg-recv-actions">
        <a href="/sign-in" class="reg-recv-btn-primary">
          Continue to sign in
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <!-- ========== SECONDARY ========== -->
      <div class="reg-recv-footer">
        <a href="/" class="reg-recv-secondary-link">← Return to home</a>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>