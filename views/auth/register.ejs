<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Register · Globe Trust Bank</title>
  <meta name="description" content="Create a Globe Trust Bank portal profile. Account eligibility and banking services require bank approval.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/register.css">
</head>
<body class="register-page">
  <%- include('../partials/header') %>

  <main class="register-shell">

    <!-- LEFT: Form -->
    <section class="register-form-panel">
      <div class="register-form-wrap">
        <span class="eyebrow">Create account</span>
        <h1 class="register-title">Open your portal profile.</h1>
        <p class="register-subtitle">
          Create a portal profile. Account eligibility and banking services
          require bank approval.
        </p>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="form-alert form-alert-error"><%= error %></div>
        <% } %>

        <form method="POST" action="/register" class="register-form" novalidate>
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

          <!-- Name row -->
          <div class="form-row">
            <div class="form-group">
              <label for="firstName">First name</label>
              <input
                type="text"
                id="firstName"
                name="firstName"
                required
                autocomplete="given-name"
                value="<%= typeof values !== 'undefined' && values.firstName ? values.firstName : '' %>"
              >
            </div>
            <div class="form-group">
              <label for="lastName">Last name</label>
              <input
                type="text"
                id="lastName"
                name="lastName"
                required
                autocomplete="family-name"
                value="<%= typeof values !== 'undefined' && values.lastName ? values.lastName : '' %>"
              >
            </div>
          </div>

          <!-- Email -->
          <div class="form-group">
            <label for="email">Email address</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>"
            >
          </div>

          <!-- Phone (optional) -->
          <div class="form-group">
            <label for="phoneE164">
              Phone <span class="label-optional">optional</span>
            </label>
            <input
              type="tel"
              id="phoneE164"
              name="phoneE164"
              autocomplete="tel"
              placeholder="+234 800 000 0000"
              value="<%= typeof values !== 'undefined' && values.phoneE164 ? values.phoneE164 : '' %>"
            >
          </div>

          <!-- Country -->
          <div class="form-group">
            <label for="countryCode">Country</label>
            <select id="countryCode" name="countryCode" required autocomplete="country">
              <option value="" disabled <%= !(typeof values !== 'undefined' && values.countryCode) ? 'selected' : '' %>>Select your country</option>
              <% (typeof countries !== 'undefined' ? countries : []).forEach(function (c) { %>
                <option value="<%= c.code %>"
                  <%= typeof values !== 'undefined' && values.countryCode === c.code ? 'selected' : '' %>>
                  <%= c.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <!-- Password -->
          <div class="form-group">
            <label for="password">
              Password
              <span class="label-hint">min 12 · upper · lower · number</span>
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="new-password"
              minlength="12"
              placeholder="Create a strong password"
            >
          </div>

          <button type="submit" class="btn btn-gold btn-block">Create profile →</button>

          <p class="form-terms">
            By creating an account you agree to our
            <a href="/legal">terms</a> and <a href="/privacy">privacy policy</a>.
          </p>
        </form>

        <div class="register-secondary">
          <p>
            Already registered?
            <a href="/sign-in">Sign in</a>
          </p>
        </div>
      </div>
    </section>

    <!-- RIGHT: Brand panel -->
    <aside class="register-brand-panel">
      <div class="register-brand-inner">
        <div class="register-brand-mark">GT</div>
        <h2>Globe Trust Bank</h2>
        <p>
          A bank built on unhurried conversation, plain language, and the
          things that actually matter.
        </p>

        <div class="register-brand-section">
          <h4>What happens next</h4>
          <ol class="register-steps">
            <li>
              <span class="step-num">01</span>
              <div>
                <strong>Create your profile</strong>
                <span>Takes about a minute.</span>
              </div>
            </li>
            <li>
              <span class="step-num">02</span>
              <div>
                <strong>Verify your identity</strong>
                <span>A short KYC check via email or SMS.</span>
              </div>
            </li>
            <li>
              <span class="step-num">03</span>
              <div>
                <strong>Bank approval</strong>
                <span>An authorised member of staff reviews your account.</span>
              </div>
            </li>
          </ol>
        </div>

        <div class="register-brand-footer">
          <a href="/security">Security at Globe Trust →</a>
        </div>
      </div>
    </aside>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>