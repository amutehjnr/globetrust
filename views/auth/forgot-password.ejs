<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Forgot password · Globe Trust Bank</title>
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container page-hero" style="max-width:28rem;">
    <h1>Forgot password</h1>
    <p class="prose">Enter your email. If an account exists, a single-use reset link will be issued (email delivery via approved provider in production).</p>
    <% if (error) { %><div class="notice" style="border-left-color:#8B3A3A;"><%= error %></div><% } %>
    <% if (success) { %><div class="notice"><%= success %></div><% } %>
    <% if (devToken) { %><div class="notice"><strong>Dev token only:</strong> <code><%= devToken %></code><br><a href="/reset-password?token=<%= devToken %>">Open reset form</a></div><% } %>
    <form method="post" action="/forgot-password" style="margin-top:1rem;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label style="display:block;font-weight:600;margin-bottom:0.35rem;">Email</label>
      <input name="email" type="email" required style="width:100%;padding:0.7rem;margin-bottom:1rem;border:1px solid #E4E0D8;border-radius:8px;">
      <button class="btn btn-navy" type="submit">Request reset</button>
    </form>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
