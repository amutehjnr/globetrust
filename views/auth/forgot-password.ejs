<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Forgot password · Globe Trust Bank</title>
  <meta name="description" content="Reset your Globe Trust Bank password.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/forgot-password.css">
</head>
<body class="fp-page">
  <%- include('../partials/header') %>

  <main class="fp-shell">

    <!-- ========== LEFT: FORM ========== -->
    <section class="fp-form-panel">
      <div class="fp-form-wrap">

        <% if (typeof success !== 'undefined' && success) { %>

          <!-- SUCCESS STATE -->
          <div class="fp-success">
            <div class="fp-success-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <span class="fp-eyebrow">Check your inbox</span>
            <h1 class="fp-title">Reset link sent.</h1>
            <p class="fp-lead"><%= success %></p>

            <% if (typeof devToken !== 'undefined' && devToken) { %>
              <div class="fp-dev-block">
                <div class="fp-dev-label">Dev only · reset link</div>
                <div class="fp-dev-token"><code><%= devToken %></code></div>
                <a href="/reset-password?token=<%= devToken %>" class="fp-dev-link">
                  Open reset form →
                </a>
              </div>
            <% } %>

            <div class="fp-success-links">
              <a href="/sign-in" class="fp-secondary-link">← Back to sign in</a>
              <a href="/forgot-password" class="fp-secondary-link">Send to a different email</a>
            </div>
          </div>

        <% } else { %>

          <!-- FORM STATE -->
          <span class="fp-eyebrow">Password reset</span>
          <h1 class="fp-title">Forgot your password?</h1>
          <p class="fp-lead">
            Enter your email. If an account exists, a single-use reset link
            will be issued.
          </p>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="fp-alert fp-alert-error">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
              </svg>
              <span><%= error %></span>
            </div>
          <% } %>

          <form method="post" action="/forgot-password" class="fp-form" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="fp-field">
              <label for="fp-email">Email address</label>
              <input
                type="email"
                id="fp-email"
                name="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
              >
            </div>

            <button type="submit" class="fp-submit">
              Send reset link
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </button>
          </form>

          <div class="fp-secondary">
            <a href="/sign-in" class="fp-secondary-link">← Back to sign in</a>
            <span class="fp-secondary-sep">·</span>
            <a href="/register" class="fp-secondary-link">Create account</a>
          </div>

          <div class="fp-security">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
            <div>
              <strong>We'll never email you asking for your password.</strong>
              <span>Reset links expire in one hour and can only be used once.</span>
            </div>
          </div>

        <% } %>

      </div>
    </section>

    <!-- ========== RIGHT: BRAND PANEL ========== -->
    <aside class="fp-brand-panel">
      <div class="fp-brand-inner">
        <div class="fp-brand-mark">GT</div>
        <h2>Globe Trust Bank</h2>
        <p>
          A bank built on unhurried conversation, plain language, and the
          things that actually matter.
        </p>

        <div class="fp-brand-section">
          <h4>What happens next</h4>
          <ol class="fp-steps">
            <li>
              <span class="fp-step-num">01</span>
              <div>
                <strong>Check your inbox</strong>
                <span>We'll send a reset link if the email matches an account.</span>
              </div>
            </li>
            <li>
              <span class="fp-step-num">02</span>
              <div>
                <strong>Click the link</strong>
                <span>Valid for one hour, one use only.</span>
              </div>
            </li>
            <li>
              <span class="fp-step-num">03</span>
              <div>
                <strong>Set a new password</strong>
                <span>Sign in with it immediately — old sessions end.</span>
              </div>
            </li>
          </ol>
        </div>

        <div class="fp-brand-footer">
          <a href="/security">Security at Globe Trust →</a>
        </div>
      </div>
    </aside>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>