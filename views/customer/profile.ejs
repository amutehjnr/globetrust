<%- include('../partials/customer-shell-start') %>
<%
  var firstName = profile && profile.firstName ? profile.firstName : '';
  var lastName  = profile && profile.lastName ? profile.lastName : '';
  var initials  = ((firstName[0] || '') + (lastName[0] || '')).toUpperCase() || '?';
  var fullName  = (firstName + ' ' + lastName).trim() || 'Your name';
  var photoUrl  = profile && profile.profilePhotoUrl ? profile.profilePhotoUrl : '';
%>

<div class="profile-page">
  <div class="profile-header">
    <div>
      <h1>Profile</h1>
      <p>Manage your personal details, photo, and country.</p>
    </div>
    <a href="/app/settings" class="profile-link">Settings →</a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="profile-alert profile-alert-error"><%= error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="profile-alert profile-alert-success"><%= success %></div>
  <% } %>

  <div class="profile-identity">
    <div class="profile-photo">
      <% if (photoUrl) { %>
        <img src="<%= photoUrl %>" alt="<%= fullName %>" width="80" height="80">
      <% } else { %>
        <span class="profile-photo__fallback"><%= initials %></span>
      <% } %>
    </div>
    <div class="profile-identity-info">
      <strong><%= fullName %></strong>
      <span><%= profile && profile.email ? profile.email : 'No email on file' %></span>
    </div>
    <span class="profile-identity-chip">Verified email</span>
  </div>

  <section class="profile-section">
    <div class="profile-section-head">
      <h2>Profile photo</h2>
      <span>JPEG, PNG or WebP · max 1MB · appears on dashboard &amp; settings</span>
    </div>
    <form method="post" action="/app/profile/photo" enctype="multipart/form-data" class="profile-photo-form">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" name="returnTo" value="profile">
      <div class="profile-photo-row">
        <input type="file" id="profile-photo-input" name="photo" accept="image/jpeg,image/png,image/webp" required>
        <button type="submit" class="profile-btn profile-btn-primary">Upload photo</button>
      </div>
    </form>
  </section>

  <form method="post" action="/app/profile" class="profile-form" id="profile-form">
    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

    <section class="profile-section">
      <div class="profile-section-head">
        <h2>Identity</h2>
        <span>Your legal name as it appears on official documents</span>
      </div>
      <div class="profile-grid profile-grid-3">
        <div class="profile-field">
          <label for="profile-first">First name <span class="req">*</span></label>
          <input type="text" id="profile-first" name="firstName" required autocomplete="given-name"
            value="<%= profile && profile.firstName ? profile.firstName : '' %>">
        </div>
        <div class="profile-field">
          <label for="profile-middle">Middle name</label>
          <input type="text" id="profile-middle" name="middleName" autocomplete="additional-name"
            value="<%= profile && profile.middleName ? profile.middleName : '' %>">
        </div>
        <div class="profile-field">
          <label for="profile-last">Last name <span class="req">*</span></label>
          <input type="text" id="profile-last" name="lastName" required autocomplete="family-name"
            value="<%= profile && profile.lastName ? profile.lastName : '' %>">
        </div>
      </div>
    </section>

    <section class="profile-section">
      <div class="profile-section-head">
        <h2>Location &amp; locale</h2>
        <span>Used for banks on transfers and communication preferences</span>
      </div>
      <div class="profile-grid profile-grid-2">
        <div class="profile-field">
          <label for="profile-country">Country</label>
          <select id="profile-country" name="countryCode" autocomplete="country">
            <option value="">Select country</option>
            <% (typeof countries !== 'undefined' ? countries : []).forEach(function (c) { %>
              <option value="<%= c.code %>" <%= profile && profile.countryCode === c.code ? 'selected' : '' %>>
                <%= c.name %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="profile-field">
          <label for="profile-locale">Preferred language code</label>
          <input type="text" id="profile-locale" name="preferredLocale" maxlength="12"
            value="<%= profile && profile.preferredLocale ? profile.preferredLocale : 'en' %>"
            placeholder="en">
        </div>
      </div>
    </section>

    <div class="profile-actions">
      <button type="submit" class="profile-btn profile-btn-primary">Save profile</button>
      <a href="/app/settings" class="profile-btn profile-btn-ghost">Back to settings</a>
    </div>
  </form>
</div>

<%- include('../partials/customer-shell-end') %>
Grok finished responding