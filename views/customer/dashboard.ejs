<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard · Globe Trust Bank</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/portal.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="db-body">
<%
  var firstName = (profile && profile.firstName) ? profile.firstName : 'there';
  var lastName = (profile && profile.lastName) ? profile.lastName : '';
  var fullName = (firstName !== 'there' ? firstName + (lastName ? ' ' + lastName : '') : 'Customer');
  var initials = ((firstName !== 'there' ? firstName.charAt(0) : 'C') + (lastName ? lastName.charAt(0) : '')).toUpperCase();
  var profilePhotoUrl = (profile && profile.profilePhotoUrl)
    ? profile.profilePhotoUrl
    : (typeof user !== 'undefined' && user && user.profilePhotoUrl ? user.profilePhotoUrl : '');
  var preferredLocale = (profile && profile.preferredLocale) ? profile.preferredLocale : 'en';
  var homeCode = (typeof currencyCode !== 'undefined' && currencyCode)
    ? currencyCode
    : (typeof homeCurrency !== 'undefined' && homeCurrency && homeCurrency.code)
      ? homeCurrency.code
      : (profile && profile.countryCode === 'NG' ? 'NGN' : 'USD');
  var homeSym = (typeof currencySymbol !== 'undefined' && currencySymbol)
    ? currencySymbol
    : (typeof homeCurrency !== 'undefined' && homeCurrency && homeCurrency.symbol)
      ? homeCurrency.symbol
      : (homeCode === 'NGN' ? '₦' : homeCode === 'EUR' ? '€' : homeCode === 'GBP' ? '£' : '$');
  function fmtMoney(val, code) {
    if (val == null || val === '') return '—';
    var s = String(val);
    var num = Number(String(s).replace(/[^0-9.-]/g, ''));
    if (isNaN(num)) return s;
    var c = (code || homeCode || 'USD').toUpperCase();
    try {
      return Number(num).toLocaleString('en-US', { style: 'currency', currency: c, minimumFractionDigits: 2, maximumFractionDigits: 2 });
    } catch (e) {
      var sym = c === 'EUR' ? '€' : c === 'GBP' ? '£' : c === 'NGN' ? '₦' : (c === homeCode ? homeSym : c + ' ');
      return sym + num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
  }
  var totalBalance = 0;
  var checking = null, savings = null, euro = null;
  if (accounts && accounts.length) {
    accounts.forEach(function(a) {
      var n = a.balance && a.balance.available != null ? Number(String(a.balance.available).replace(/[^0-9.-]/g, '')) : 0;
      if (!isNaN(n)) totalBalance += n;
      var label = ((a.displayLabel || '') + ' ' + (a.currencyCode || '')).toLowerCase();
      if (!checking && (label.indexOf('check') >= 0 || a.currencyCode === homeCode || a.currencyCode === 'USD')) checking = a;
      if (!savings && label.indexOf('sav') >= 0) savings = a;
      if (!euro && a.currencyCode === 'EUR') euro = a;
    });
    if (!checking && accounts[0]) checking = accounts[0];
    if (!savings && accounts[1]) savings = accounts[1];
  }
  var nowStr = new Date().toLocaleString('en-US', {
    month: 'short', day: 'numeric', year: 'numeric',
    hour: 'numeric', minute: '2-digit'
  });
  var limits = (profile && profile.spendingLimits) ? profile.spendingLimits : {};
  function limitOrDerived(key, factor) {
    var v = limits && limits[key] != null && !isNaN(Number(limits[key])) ? Number(limits[key]) : null;
    if (v != null) return v;
    return totalBalance > 0 ? Math.round(totalBalance * factor * 100) / 100 : 0;
  }
  var spendingCards = [
    { key: 'overall', label: 'Spending limit', value: limitOrDerived('overall', 1), hint: 'Total available to spend' },
    { key: 'daily', label: 'Daily spending limit', value: limitOrDerived('daily', 0.2), hint: 'Resets each day' },
    { key: 'monthly', label: 'Monthly spending limit', value: limitOrDerived('monthly', 0.8), hint: 'Resets each month' },
    { key: 'shopping', label: 'Shopping spending limit', value: limitOrDerived('shopping', 0.3), hint: 'In-store & retail' },
    { key: 'online', label: 'Online shopping limit', value: limitOrDerived('online', 0.25), hint: 'E-commerce & digital' },
    { key: 'other', label: 'Other limit', value: limits && limits.other != null ? Number(limits.other) : null, hint: 'Set by admin' }
  ];

%>
  <div class="db-shell" data-must-enroll-mfa="<%= typeof mustEnrollMfa !== 'undefined' && mustEnrollMfa ? '1' : '0' %>">
    <%- include('../partials/customer-nav') %>

    <div class="db-main">
      <header class="db-topbar">
        <div class="db-search">
          <svg class="db-search__icon" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
          <input type="search" placeholder="Search transactions, payees, or services…" aria-label="Search">
        </div>
        <div class="db-topbar__right">
          <button type="button" class="db-icon-btn" aria-label="Notifications">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
            </svg>
          </button>
          <div class="db-translator notranslate" id="db-translator" translate="no" data-csrf="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" data-initial-lang="<%= preferredLocale || 'en' %>">
            <button type="button" class="lang-trigger notranslate" id="lang-trigger" translate="no" aria-haspopup="listbox" aria-expanded="false" aria-label="Language">
              <span class="lang-trigger__icon" aria-hidden="true">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8M12 3c2.5 3 4 6 4 9s-1.5 6-4 9c-2.5-3-4-6-4-9s1.5-6 4-9z" />
                </svg>
              </span>
              <span class="lang-trigger__label" id="lang-trigger-label">English</span>
              <span class="lang-trigger__chevron" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg>
              </span>
            </button>
            <div class="lang-panel notranslate" id="lang-panel" translate="no" hidden>
              <div class="lang-panel__search">
                <input type="search" id="lang-search" class="lang-search" placeholder="Search language…" autocomplete="off" aria-label="Search language">
              </div>
              <div class="lang-panel__list notranslate" id="lang-list" translate="no" role="listbox" aria-label="Languages">
                <button type="button" class="lang-item" role="option" data-lang="en" data-label="English">
                  <span class="lang-item__native">English</span>
                  <span class="lang-item__en">English</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="fr" data-label="Français">
                  <span class="lang-item__native">Français</span>
                  <span class="lang-item__en">French</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="es" data-label="Español">
                  <span class="lang-item__native">Español</span>
                  <span class="lang-item__en">Spanish</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="pt" data-label="Português">
                  <span class="lang-item__native">Português</span>
                  <span class="lang-item__en">Portuguese</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="de" data-label="Deutsch">
                  <span class="lang-item__native">Deutsch</span>
                  <span class="lang-item__en">German</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="it" data-label="Italiano">
                  <span class="lang-item__native">Italiano</span>
                  <span class="lang-item__en">Italian</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="nl" data-label="Nederlands">
                  <span class="lang-item__native">Nederlands</span>
                  <span class="lang-item__en">Dutch</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="ru" data-label="Русский">
                  <span class="lang-item__native">Русский</span>
                  <span class="lang-item__en">Russian</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="zh-CN" data-label="中文 (简体)">
                  <span class="lang-item__native">中文 (简体)</span>
                  <span class="lang-item__en">Chinese Simplified</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="zh-TW" data-label="中文 (繁體)">
                  <span class="lang-item__native">中文 (繁體)</span>
                  <span class="lang-item__en">Chinese Traditional</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="ja" data-label="日本語">
                  <span class="lang-item__native">日本語</span>
                  <span class="lang-item__en">Japanese</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="ko" data-label="한국어">
                  <span class="lang-item__native">한국어</span>
                  <span class="lang-item__en">Korean</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="ar" data-label="العربية">
                  <span class="lang-item__native">العربية</span>
                  <span class="lang-item__en">Arabic</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="hi" data-label="हिन्दी">
                  <span class="lang-item__native">हिन्दी</span>
                  <span class="lang-item__en">Hindi</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="bn" data-label="বাংলা">
                  <span class="lang-item__native">বাংলা</span>
                  <span class="lang-item__en">Bengali</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="tr" data-label="Türkçe">
                  <span class="lang-item__native">Türkçe</span>
                  <span class="lang-item__en">Turkish</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="pl" data-label="Polski">
                  <span class="lang-item__native">Polski</span>
                  <span class="lang-item__en">Polish</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="vi" data-label="Tiếng Việt">
                  <span class="lang-item__native">Tiếng Việt</span>
                  <span class="lang-item__en">Vietnamese</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="th" data-label="ไทย">
                  <span class="lang-item__native">ไทย</span>
                  <span class="lang-item__en">Thai</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="id" data-label="Bahasa Indonesia">
                  <span class="lang-item__native">Bahasa Indonesia</span>
                  <span class="lang-item__en">Indonesian</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="ms" data-label="Bahasa Melayu">
                  <span class="lang-item__native">Bahasa Melayu</span>
                  <span class="lang-item__en">Malay</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="sv" data-label="Svenska">
                  <span class="lang-item__native">Svenska</span>
                  <span class="lang-item__en">Swedish</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="da" data-label="Dansk">
                  <span class="lang-item__native">Dansk</span>
                  <span class="lang-item__en">Danish</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="fi" data-label="Suomi">
                  <span class="lang-item__native">Suomi</span>
                  <span class="lang-item__en">Finnish</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="no" data-label="Norsk">
                  <span class="lang-item__native">Norsk</span>
                  <span class="lang-item__en">Norwegian</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="cs" data-label="Čeština">
                  <span class="lang-item__native">Čeština</span>
                  <span class="lang-item__en">Czech</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="ro" data-label="Română">
                  <span class="lang-item__native">Română</span>
                  <span class="lang-item__en">Romanian</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="hu" data-label="Magyar">
                  <span class="lang-item__native">Magyar</span>
                  <span class="lang-item__en">Hungarian</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="el" data-label="Ελληνικά">
                  <span class="lang-item__native">Ελληνικά</span>
                  <span class="lang-item__en">Greek</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="he" data-label="עברית">
                  <span class="lang-item__native">עברית</span>
                  <span class="lang-item__en">Hebrew</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="uk" data-label="Українська">
                  <span class="lang-item__native">Українська</span>
                  <span class="lang-item__en">Ukrainian</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="fa" data-label="فارسی">
                  <span class="lang-item__native">فارسی</span>
                  <span class="lang-item__en">Persian</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="ur" data-label="اردو">
                  <span class="lang-item__native">اردو</span>
                  <span class="lang-item__en">Urdu</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="ta" data-label="தமிழ்">
                  <span class="lang-item__native">தமிழ்</span>
                  <span class="lang-item__en">Tamil</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="tl" data-label="Filipino">
                  <span class="lang-item__native">Filipino</span>
                  <span class="lang-item__en">Filipino</span>
                </button>
                <button type="button" class="lang-item" role="option" data-lang="ca" data-label="Català">
                  <span class="lang-item__native">Català</span>
                  <span class="lang-item__en">Catalan</span>
                </button>
              </div>
            </div>
            <select id="db-language" class="lang-native-select" aria-hidden="true" tabindex="-1">
              <option value="en" selected>English</option>
              <option value="fr">Français</option>
              <option value="es">Español</option>
              <option value="pt">Português</option>
              <option value="de">Deutsch</option>
              <option value="it">Italiano</option>
              <option value="nl">Nederlands</option>
              <option value="ru">Русский</option>
              <option value="zh-CN">中文 (简体)</option>
              <option value="zh-TW">中文 (繁體)</option>
              <option value="ja">日本語</option>
              <option value="ko">한국어</option>
              <option value="ar">العربية</option>
              <option value="hi">हिन्दी</option>
              <option value="bn">বাংলা</option>
              <option value="tr">Türkçe</option>
              <option value="pl">Polski</option>
              <option value="vi">Tiếng Việt</option>
              <option value="th">ไทย</option>
              <option value="id">Bahasa Indonesia</option>
              <option value="ms">Bahasa Melayu</option>
              <option value="sv">Svenska</option>
              <option value="da">Dansk</option>
              <option value="fi">Suomi</option>
              <option value="no">Norsk</option>
              <option value="cs">Čeština</option>
              <option value="ro">Română</option>
              <option value="hu">Magyar</option>
              <option value="el">Ελληνικά</option>
              <option value="he">עברית</option>
              <option value="uk">Українська</option>
              <option value="fa">فارسی</option>
              <option value="ur">اردو</option>
              <option value="ta">தமிழ்</option>
              <option value="tl">Filipino</option>
              <option value="ca">Català</option>
            </select>
          </div>
          <div id="google_translate_element" class="db-translator__google" hidden></div>
        </div>
      </header>

      <div class="db-content">
        <% if (typeof mustEnrollMfa !== 'undefined' && mustEnrollMfa) { %>
          <div class="db-alert db-alert--err">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
            <span>Multi-factor authentication is required before transfers. <a href="/mfa/enrol"><strong>Set up authenticator →</strong></a></span>
          </div>
        <% } %>

        <div class="db-greeting">
          <div class="db-greeting__identity">
            <a href="/app/profile" class="db-greeting__photo" title="Edit profile photo">
              <% if (profilePhotoUrl && String(profilePhotoUrl).indexOf('data:') === 0 || profilePhotoUrl) { %>
                <img
                  src="<%= profilePhotoUrl %>"
                  alt="<%= fullName %>"
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                >
              <% } else { %>
                <span class="db-greeting__photo-fallback" aria-hidden="true"><%= initials %></span>
              <% } %>
            </a>
            <div class="db-greeting__text">
              <h1>Welcome, <em><%= fullName %></em>.</h1>
              <p>Here's your account overview.</p>
            </div>
          </div>
          <div class="db-greeting__meta">
            <span><%= nowStr %></span>
            <span class="db-online"><i></i> Online</span>
          </div>
        </div>


        <!-- ========== BALANCE CARDS ========== -->
        <div class="db-balance-grid">
          <article class="db-bal-card db-bal-card--total">
            <div class="db-bal-card__icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 00-2.25-2.25H15a3 3 0 11-6 0H5.25A2.25 2.25 0 003 12m18 0v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 9m18 0V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v3" />
              </svg>
            </div>
            <div class="db-bal-card__label">Total Balance</div>
            <div class="db-bal-card__value"><%= accounts && accounts.length ? fmtMoney(totalBalance, homeCode) : '$0.00' %></div>
            <div class="db-bal-card__hint">Across linked accounts</div>
          </article>

          <button type="button" class="db-bal-card db-bal-card--link" data-action-modal="wire" aria-haspopup="dialog">
            <div class="db-bal-card__icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
              </svg>
            </div>
            <div class="db-bal-card__label">Wire transfer</div>
            <div class="db-bal-card__value">Send funds</div>
            <div class="db-bal-card__hint">Bank wire · international</div>
          </button>

          <button type="button" class="db-bal-card db-bal-card--link" data-action-modal="wallet" aria-haspopup="dialog">
            <div class="db-bal-card__icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 00-2.25-2.25H15a3 3 0 11-6 0H5.25A2.25 2.25 0 003 12m18 0v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 9m18 0V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v3" />
              </svg>
            </div>
            <div class="db-bal-card__label">Transfer to wallet</div>
            <div class="db-bal-card__value">Move money</div>
            <div class="db-bal-card__hint">Internal wallet transfer</div>
          </button>

          <button type="button" class="db-bal-card db-bal-card--link" data-action-modal="personal-bank" aria-haspopup="dialog">
            <div class="db-bal-card__icon">
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12v6.75H3V3z" />
              </svg>
            </div>
            <div class="db-bal-card__label">Transfer to personal bank</div>
            <div class="db-bal-card__value">To your bank</div>
            <div class="db-bal-card__hint">Linked personal account</div>
          </button>
        </div>

        <!-- ========== MID GRID ========== -->
        <div class="db-mid-grid">

          <!-- Chart -->
          <section class="db-panel">
            <div class="db-panel__head">
              <h2>Account Overview</h2>
              <span class="db-chip">Last 6 Months</span>
            </div>
            <div class="db-chart" role="img" aria-label="Monthly activity chart">
              <%
                var bars = [42, 58, 48, 72, 65, 88];
                var months = ['Nov','Dec','Jan','Feb','Mar','Apr'];
              %>
              <% bars.forEach(function(h, i) { %>
                <div class="db-chart__col">
                  <div class="db-chart__bar" data-height="<%= h %>"></div>
                  <span><%= months[i] %></span>
                </div>
              <% }) %>
            </div>
          </section>

          <!-- Recent transactions -->
          <section class="db-panel">
            <div class="db-panel__head">
              <h2>Recent Transactions</h2>
              <a href="/app/transfers">View all →</a>
            </div>
            <% if (!recentTransfers || !recentTransfers.length) { %>
              <p class="db-muted">No recent transfers yet.</p>
            <% } else { %>
              <ul class="db-tx-list">
                <% recentTransfers.forEach(function(h) { %>
                  <%
                    var st = h.status || 'pending';
                    var stClass = st === 'succeeded' ? 'ok' : st === 'failed' ? 'err' : 'pending';
                    var amtStr = String(h.sourceAmount || '');
                    var isOut = amtStr.indexOf('-') === 0;
                    var absAmt = isNaN(parseFloat(amtStr)) ? amtStr : Math.abs(parseFloat(amtStr)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                  %>
                  <li>
                    <span class="db-tx-icon db-tx-icon--<%= stClass %>">
                      <% if (st === 'succeeded') { %>
                        <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                      <% } else if (st === 'failed') { %>
                        <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                      <% } else { %>
                        <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      <% } %>
                    </span>
                    <div class="db-tx-body">
                      <strong><%= h.destinationLabel || h.reference || 'Transfer' %></strong>
                      <small><%= h.createdAt %></small>
                    </div>
                    <div class="db-tx-amt">
                      <strong class="<%= isOut ? 'db-tx-amt--out' : 'db-tx-amt--in' %>">
                        <%= isOut ? '−' : '+' %><%= absAmt %> <span class="db-tx-amt__cur"><%= h.sourceCurrency %></span>
                      </strong>
                      <span class="db-badge db-badge--<%= stClass %>">
                        <span class="db-badge__dot"></span>
                        <%= st.charAt(0).toUpperCase() + st.slice(1) %>
                      </span>
                    </div>
                  </li>
                <% }) %>
              </ul>
            <% } %>
          </section>

          <!-- Promo -->
          <aside class="db-promo">
            <p class="db-promo__eyebrow">Global Transfers</p>
            <h3>Made Easy</h3>
            <p>Send money to over 200 countries with low fees and great rates.</p>
            <a class="db-promo__btn" href="/app/transfers">
              Make a Transfer
              <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </aside>
        </div>

        <!-- ========== SPENDING LIMITS ========== -->
        <section class="db-panel db-limits">
          <div class="db-panel__head">
            <h2>Spending limits</h2>
            <span class="db-chip">Linked to balance</span>
          </div>
          <div class="db-limits-grid">
            <% spendingCards.forEach(function (card) { %>
              <article class="db-limit-card" data-limit-key="<%= card.key %>">
                <div class="db-limit-card__label"><%= card.label %></div>
                <div class="db-limit-card__value">
                  <% if (card.value == null || isNaN(card.value)) { %>
                    <span class="db-limit-card__empty">—</span>
                  <% } else { %>
                    <%= fmtMoney(card.value, homeCode) %>
                  <% } %>
                </div>
                <div class="db-limit-card__hint"><%= card.hint %></div>
                <% if (card.value != null && totalBalance > 0 && !isNaN(card.value)) { %>
                  <% var pct = Math.min(100, Math.round((Number(card.value) / totalBalance) * 100)); %>
                  <div class="db-limit-card__bar" aria-hidden="true">
                    <span style="width: <%= pct %>%"></span>
                  </div>
                  <div class="db-limit-card__pct"><%= pct %>% of balance</div>
                <% } %>
              </article>
            <% }) %>
          </div>
        </section>

      </div>
    </div>
  </div>

  <!-- Chart bars script -->
  <script>
    (function () {
      document.querySelectorAll('.db-chart__bar[data-height]').forEach(function (bar) {
        var h = parseFloat(bar.dataset.height) || 0;
        bar.style.height = Math.max(4, Math.min(100, h)) + '%';
      });
    })();
  </script>


  <!-- Full-screen submit loader -->
  <div class="db-loading-overlay" id="db-loading-overlay" hidden aria-live="polite" aria-busy="true">
    <div class="db-loading-overlay__card">
      <div class="db-loading-overlay__spinner" aria-hidden="true">
        <span class="db-loading-overlay__spinner-core"></span>
      </div>
      <p class="db-loading-overlay__title">Processing your request</p>
      <p class="db-loading-overlay__hint">Please wait</p>
      <div class="db-loading-overlay__dots" aria-hidden="true"><i></i><i></i><i></i></div>
    </div>
  </div>


  <!-- Failed transaction + point to live chat -->
  <div class="db-fail-overlay" id="db-fail-overlay" hidden>
    <div class="db-fail-overlay__backdrop"></div>
    <div class="db-fail-card" role="alertdialog" aria-labelledby="db-fail-title" aria-describedby="db-fail-desc">
      <div class="db-fail-card__icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
      </div>
      <h2 id="db-fail-title">Transaction failed</h2>
      <p id="db-fail-desc">We couldn't complete this transfer right now. Please contact live support so we can help you finish it securely.</p>
      <div class="db-fail-card__actions">
        <button type="button" class="db-modal__btn db-modal__btn--primary" id="db-fail-chat">Chat with support</button>
        <button type="button" class="db-modal__btn db-modal__btn--ghost" id="db-fail-close">Close</button>
      </div>
    </div>
    <div class="db-chat-pointer" id="db-chat-pointer" hidden aria-hidden="true">
      <div class="db-chat-pointer__label">Live support is here</div>
      <div class="db-chat-pointer__hand">👇</div>
      <div class="db-chat-pointer__arrow"></div>
    </div>
  </div>

  <!-- ========== ACTION MODALS ========== -->
  <div class="db-modal-root" id="db-modal-root" hidden>
    <div class="db-modal-backdrop" data-close-modal></div>

    <!-- Wire transfer -->
    <div class="db-modal" id="modal-wire" role="dialog" aria-modal="true" aria-labelledby="modal-wire-title" hidden>
      <div class="db-modal__panel">
        <header class="db-modal__head">
          <h2 id="modal-wire-title">Wire transfer</h2>
          <button type="button" class="db-modal__close" data-close-modal aria-label="Close">&times;</button>
        </header>
        <form method="post" action="/app/transfers" class="db-modal__form">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <input type="hidden" name="idempotencyKey" value="<%= typeof idempotencyKey !== 'undefined' ? idempotencyKey : '' %>-wire">
          <input type="hidden" name="destinationBankCode" id="wire-bank-code" value="">
          <div class="db-modal__field">
            <label for="wire-source">From account</label>
            <select id="wire-source" name="sourceAccountLinkId" required>
              <option value="" disabled selected>Select account</option>
              <% (accounts || []).forEach(function (a) { %>
                    <option value="<%= a.id %>" data-currency="<%= a.currencyCode || a.currency || '' %>">
                      <%= a.displayLabel || a.currencyCode || 'Account' %><% if (a.available != null || (a.balance && a.balance.available != null)) { %> · <%= a.available != null ? a.available : a.balance.available %><% } %>
                    </option>
                  <% }) %>
            </select>
          </div>
          <div class="db-modal__field">
            <label for="wire-bank">Destination bank</label>
            <select id="wire-bank" required>
              <option value="" disabled selected>Loading banks…</option>
            </select>
          </div>
          <div class="db-modal__field">
            <label for="wire-account">Beneficiary account / IBAN</label>
            <input type="text" id="wire-account" name="destinationAccountRef" required minlength="4" maxlength="34" placeholder="Account number or IBAN" autocomplete="off">
          </div>
          <div class="db-modal__field">
            <label for="wire-amount">Amount</label>
            <input type="text" id="wire-amount" name="amount" required inputmode="decimal" placeholder="0.00" autocomplete="off">
          </div>
          <div class="db-modal__field">
            <label for="wire-narrative">Reference <span class="db-modal__optional">optional</span></label>
            <input type="text" id="wire-narrative" name="narrative" maxlength="140" placeholder="Wire transfer">
          </div>
          <footer class="db-modal__actions">
            <button type="button" class="db-modal__btn db-modal__btn--ghost" data-close-modal>Cancel</button>
            <button type="submit" class="db-modal__btn db-modal__btn--primary">Submit wire transfer</button>
          </footer>
        </form>
      </div>
    </div>

    <!-- Transfer to wallet -->
    <div class="db-modal" id="modal-wallet" role="dialog" aria-modal="true" aria-labelledby="modal-wallet-title" hidden>
      <div class="db-modal__panel">
        <header class="db-modal__head">
          <h2 id="modal-wallet-title">Transfer to wallet</h2>
          <button type="button" class="db-modal__close" data-close-modal aria-label="Close">&times;</button>
        </header>
        <form method="post" action="/app/transfers" class="db-modal__form">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <input type="hidden" name="idempotencyKey" value="<%= typeof idempotencyKey !== 'undefined' ? idempotencyKey : '' %>-wallet">
          <input type="hidden" name="destinationBankCode" value="WALLET">
          <div class="db-modal__field">
            <label for="wallet-source">From account</label>
            <select id="wallet-source" name="sourceAccountLinkId" required>
              <option value="" disabled selected>Select account</option>
              <% (accounts || []).forEach(function (a) { %>
                    <option value="<%= a.id %>" data-currency="<%= a.currencyCode || a.currency || '' %>">
                      <%= a.displayLabel || a.currencyCode || 'Account' %><% if (a.available != null || (a.balance && a.balance.available != null)) { %> · <%= a.available != null ? a.available : a.balance.available %><% } %>
                    </option>
                  <% }) %>
            </select>
          </div>
          <div class="db-modal__field">
            <label for="wallet-dest">Wallet ID / email / phone</label>
            <input type="text" id="wallet-dest" name="destinationAccountRef" required minlength="4" maxlength="80" placeholder="Recipient wallet identifier" autocomplete="off">
          </div>
          <div class="db-modal__field">
            <label for="wallet-amount">Amount</label>
            <input type="text" id="wallet-amount" name="amount" required inputmode="decimal" placeholder="0.00" autocomplete="off">
          </div>
          <div class="db-modal__field">
            <label for="wallet-narrative">Note <span class="db-modal__optional">optional</span></label>
            <input type="text" id="wallet-narrative" name="narrative" maxlength="140" value="Transfer to wallet" placeholder="Transfer to wallet">
          </div>
          <footer class="db-modal__actions">
            <button type="button" class="db-modal__btn db-modal__btn--ghost" data-close-modal>Cancel</button>
            <button type="submit" class="db-modal__btn db-modal__btn--primary">Send to wallet</button>
          </footer>
        </form>
      </div>
    </div>

    <!-- Transfer to personal bank -->
    <div class="db-modal" id="modal-personal-bank" role="dialog" aria-modal="true" aria-labelledby="modal-personal-bank-title" hidden>
      <div class="db-modal__panel">
        <header class="db-modal__head">
          <h2 id="modal-personal-bank-title">Transfer to personal bank</h2>
          <button type="button" class="db-modal__close" data-close-modal aria-label="Close">&times;</button>
        </header>
        <form method="post" action="/app/transfers" class="db-modal__form">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <input type="hidden" name="idempotencyKey" value="<%= typeof idempotencyKey !== 'undefined' ? idempotencyKey : '' %>-personal">
          <input type="hidden" name="destinationBankCode" id="personal-bank-code" value="">
          <div class="db-modal__field">
            <label for="personal-source">From account</label>
            <select id="personal-source" name="sourceAccountLinkId" required>
              <option value="" disabled selected>Select account</option>
              <% (accounts || []).forEach(function (a) { %>
                    <option value="<%= a.id %>" data-currency="<%= a.currencyCode || a.currency || '' %>">
                      <%= a.displayLabel || a.currencyCode || 'Account' %><% if (a.available != null || (a.balance && a.balance.available != null)) { %> · <%= a.available != null ? a.available : a.balance.available %><% } %>
                    </option>
                  <% }) %>
            </select>
          </div>
          <div class="db-modal__field">
            <label for="personal-bank">Your bank</label>
            <select id="personal-bank" required>
              <option value="" disabled selected>Loading banks…</option>
            </select>
          </div>
          <div class="db-modal__field">
            <label for="personal-account">Your account number</label>
            <input type="text" id="personal-account" name="destinationAccountRef" required minlength="4" maxlength="34" placeholder="Account number at your bank" autocomplete="off">
          </div>
          <div class="db-modal__field">
            <label for="personal-amount">Amount</label>
            <input type="text" id="personal-amount" name="amount" required inputmode="decimal" placeholder="0.00" autocomplete="off">
          </div>
          <div class="db-modal__field">
            <label for="personal-narrative">Reference <span class="db-modal__optional">optional</span></label>
            <input type="text" id="personal-narrative" name="narrative" maxlength="140" value="Transfer to personal bank" placeholder="Transfer to personal bank">
          </div>
          <footer class="db-modal__actions">
            <button type="button" class="db-modal__btn db-modal__btn--ghost" data-close-modal>Cancel</button>
            <button type="submit" class="db-modal__btn db-modal__btn--primary">Transfer to bank</button>
          </footer>
        </form>
      </div>
    </div>
  </div>

  <script src="/js/dashboard.js" defer></script>
  <script src="/js/dashboard-actions.js" defer></script>
  <script src="/js/translator.js" defer></script>

  <div class="lc-widget notranslate" id="lc-widget" translate="no" data-csrf="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <div class="lc-panel" id="lc-panel" hidden>
      <header class="lc-panel__head">
        <div>
          <h3>Live chat</h3>
          <small>Globe Trust support</small>
        </div>
        <button type="button" class="lc-panel__close" id="lc-close" aria-label="Close chat">&times;</button>
      </header>
      <p class="lc-status" id="lc-status" style="padding:8px 14px 0;margin:0;">Ready</p>
      <div class="lc-panel__body" id="lc-body">
        <p class="lc-empty">Opening chat…</p>
      </div>
      <div class="lc-panel__foot">
        <form class="lc-panel__form" id="lc-form">
          <input type="text" id="lc-input" maxlength="2000" placeholder="Type a message…" autocomplete="off" required>
          <button type="submit">Send</button>
        </form>
      </div>
    </div>
    <button type="button" class="lc-launcher" id="lc-launcher" aria-expanded="false" aria-controls="lc-panel">
      <span class="lc-launcher__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75h6.75m-6.75 3h3.375M21 12c0 4.556-4.03 8.25-9 8.25a9.76 9.76 0 01-2.53-.33L5 21l1.2-3.6A7.9 7.9 0 013 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
        </svg>
      </span>
      <span>Live chat</span>
    </button>
  </div>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/live-chat.js" defer></script>

</body>
</html>
