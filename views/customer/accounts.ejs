<%- include('../partials/customer-shell-start') %>

<div class="db-greeting">
  <div>
    <h1>Accounts</h1>
    <p>Linked accounts and sandbox balances.</p>
  </div>
  <span class="db-chip">Sandbox — not real funds</span>
</div>

<% if (!accounts || !accounts.length) { %>
  <div class="db-panel"><p class="db-muted">No account links yet.</p></div>
<% } else { %>
  <div class="db-balance-grid" style="margin-bottom:1.25rem;">
    <% accounts.forEach(function(a) { %>
      <article class="db-bal-card">
        <div class="db-bal-card__icon">▤</div>
        <div class="db-bal-card__label"><%= a.displayLabel || a.currencyCode %></div>
        <div class="db-bal-card__value">
          <% if (a.balance) { %><%= a.balance.available %><% } else { %>—<% } %>
        </div>
        <div class="db-bal-card__hint">
          <%= a.currencyCode %> · <%= a.linkStatus || 'linked' %>
          <% if (a.balance && a.balance.isDemo) { %> · demo<% } %>
        </div>
      </article>
    <% }) %>
  </div>

  <div class="db-panel">
    <div class="db-panel__head"><h2>Account details</h2></div>
    <div class="table-wrap" style="border:0;box-shadow:none;">
      <table class="data">
        <thead>
          <tr><th>Label</th><th>Currency</th><th>Available</th><th>Ledger</th><th>Status</th><th>Provider</th></tr>
        </thead>
        <tbody>
          <% accounts.forEach(function(a) { %>
            <tr>
              <td><%= a.displayLabel || 'Account' %></td>
              <td><%= a.currencyCode %></td>
              <td><%= a.balance ? a.balance.available : '—' %></td>
              <td><%= a.balance ? a.balance.ledger : '—' %></td>
              <td><%= a.linkStatus %></td>
              <td><%= a.providerCode %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('../partials/customer-shell-end') %>