<%- include('../partials/customer-shell-start') %>

<div class="db-greeting">
  <div>
    <h1>Cards</h1>
    <p>Virtual and physical cards linked to your profile.</p>
  </div>
  <span class="db-chip">Sandbox — not real funds</span>
</div>

<%
  /* Determine which card to show.
     If you pass a `cards` array from the route, we use the first one.
     Otherwise fall back to a placeholder preview. */
  var cards = (typeof cards !== 'undefined' && cards) ? cards : [];
  var primary = cards[0] || null;

  var cardNumber = primary && primary.last4 ? '•••• •••• •••• ' + primary.last4 : '•••• •••• •••• 3456';
  var cardHolder = primary && primary.holderName
    ? primary.holderName
    : (profile && profile.firstName ? (profile.firstName + ' ' + (profile.lastName || '')).trim() : 'YOUR NAME');
  var cardExpiry = primary && primary.expiry ? primary.expiry : '09/28';
  var cardBrand  = primary && primary.brand ? primary.brand : 'VISA';
  var cardType   = primary && primary.type ? primary.type : 'Debit';
  var cardStatus = primary && primary.status ? primary.status : 'Active';
  var isPreview  = !primary;
%>

<div class="cards-layout">

  <!-- ========== LEFT: Card visual + spend ========== -->
  <div class="cards-left">

    <!-- Card visual -->
    <article class="card-visual-wrap">
      <div class="card-visual" role="img" aria-label="Debit card ending <%= cardNumber.slice(-4) %>">
        <div class="card-visual-top">
          <span class="card-brand">GLOBE TRUST BANK</span>
          <span class="card-network"><%= cardBrand %></span>
        </div>

        <div class="card-chip">
          <svg viewBox="0 0 32 24" fill="none" aria-hidden="true">
            <rect x="0.5" y="0.5" width="31" height="23" rx="3.5" stroke="rgba(255,255,255,0.4)" fill="rgba(255,255,255,0.15)"/>
            <path d="M0 6h32M0 12h32M0 18h32M8 0v24M16 0v24M24 0v24" stroke="rgba(255,255,255,0.35)" stroke-width="0.7"/>
          </svg>
        </div>

        <div class="card-number"><%= cardNumber %></div>

        <div class="card-visual-bottom">
          <div class="card-meta">
            <span class="card-meta-label">CARDHOLDER</span>
            <span class="card-meta-value"><%= cardHolder.toUpperCase() %></span>
          </div>
          <div class="card-meta">
            <span class="card-meta-label">EXPIRES</span>
            <span class="card-meta-value"><%= cardExpiry %></span>
          </div>
          <div class="card-network-mark"><%= cardBrand %></div>
        </div>
      </div>

      <% if (isPreview) { %>
        <p class="card-visual-note">
          Sandbox preview. Your real card will appear here once issued.
        </p>
      <% } %>
    </article>

    <!-- Spend summary -->
    <div class="cards-spend-grid">
      <div class="cards-spend-item">
        <span class="cards-spend-label">Monthly limit</span>
        <strong class="cards-spend-value">
          <% if (primary && primary.monthlyLimit) { %>
            <%= Number(primary.monthlyLimit).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          <% } else { %>—<% } %>
        </strong>
      </div>
      <div class="cards-spend-item">
        <span class="cards-spend-label">Spent this month</span>
        <strong class="cards-spend-value">
          <% if (primary && primary.spentThisMonth) { %>
            <%= Number(primary.spentThisMonth).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          <% } else { %>—<% } %>
        </strong>
      </div>
      <div class="cards-spend-item">
        <span class="cards-spend-label">Available</span>
        <strong class="cards-spend-value cards-spend-value-ok">
          <% if (primary && primary.monthlyLimit && primary.spentThisMonth) { %>
            <%= (Number(primary.monthlyLimit) - Number(primary.spentThisMonth)).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          <% } else { %>—<% } %>
        </strong>
      </div>
    </div>

    <!-- Quick actions on the card -->
    <div class="cards-quick">
      <button type="button" class="cards-quick-btn" disabled aria-disabled="true">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
        </svg>
        <span>Freeze</span>
      </button>
      <button type="button" class="cards-quick-btn" disabled aria-disabled="true">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
        </svg>
        <span>Limits</span>
      </button>
      <button type="button" class="cards-quick-btn" disabled aria-disabled="true">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Reveal</span>
      </button>
    </div>
  </div>

  <!-- ========== RIGHT: Controls + activity ========== -->
  <div class="cards-right">

    <!-- Controls -->
    <section class="db-panel cards-panel">
      <div class="db-panel__head">
        <h2>Card controls</h2>
        <span class="cards-panel-badge"><%= cardType %> · <%= cardStatus %></span>
      </div>

      <ul class="card-controls">
        <li class="card-control">
          <div class="card-control-text">
            <strong>Online payments</strong>
            <span>Use this card for online purchases</span>
          </div>
          <span class="card-toggle card-toggle-on" role="switch" aria-checked="true" aria-disabled="true" aria-label="Online payments">
            <span class="card-toggle-thumb"></span>
          </span>
        </li>
        <li class="card-control">
          <div class="card-control-text">
            <strong>International</strong>
            <span>Allow transactions outside your country</span>
          </div>
          <span class="card-toggle card-toggle-on" role="switch" aria-checked="true" aria-disabled="true" aria-label="International transactions">
            <span class="card-toggle-thumb"></span>
          </span>
        </li>
        <li class="card-control">
          <div class="card-control-text">
            <strong>Contactless</strong>
            <span>Tap-to-pay at physical terminals</span>
          </div>
          <span class="card-toggle card-toggle-on" role="switch" aria-checked="true" aria-disabled="true" aria-label="Contactless">
            <span class="card-toggle-thumb"></span>
          </span>
        </li>
        <li class="card-control">
          <div class="card-control-text">
            <strong>ATM withdrawals</strong>
            <span>Cash access at ATMs</span>
          </div>
          <span class="card-toggle card-toggle-on" role="switch" aria-checked="true" aria-disabled="true" aria-label="ATM withdrawals">
            <span class="card-toggle-thumb"></span>
          </span>
        </li>
      </ul>

      <% if (isPreview) { %>
        <p class="cards-sandbox-note">
          Card issuance connects to the core after bank approval. This screen is a product preview.
        </p>
      <% } %>
    </section>

    <!-- Recent card activity -->
    <section class="db-panel cards-panel">
      <div class="db-panel__head">
        <h2>Recent activity</h2>
        <a href="/app/transactions" class="cards-panel-link">View all →</a>
      </div>

      <% if (typeof cardTransactions !== 'undefined' && cardTransactions && cardTransactions.length) { %>
        <ul class="card-activity">
          <% cardTransactions.slice(0, 5).forEach(function(t) { %>
            <li class="card-activity-item">
              <div class="card-activity-icon">
                <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                </svg>
              </div>
              <div class="card-activity-body">
                <strong><%= t.description || 'Card payment' %></strong>
                <span><%= t.date || '' %></span>
              </div>
              <span class="card-activity-amount">
                <%= t.amount || '' %> <%= t.currency || '' %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <div class="card-activity-empty">
          <p>No card activity yet.</p>
          <span>Payments made with this card will appear here.</span>
        </div>
      <% } %>
    </section>

  </div>

</div>

<%- include('../partials/customer-shell-end') %>