<%- include('../partials/admin-shell-start') %>

<div class="db-greeting">
  <div>
    <h1>KYC review queue</h1>
    <p>Pending identity documents.</p>
  </div>
  <span class="db-chip"><%= queue.length %> pending</span>
</div>

<% if (message) { %><div class="db-alert" style="background:#d8ead8;color:#1e5c2a;"><%= message %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="db-alert db-alert--err"><%= error %></div><% } %>

<section class="db-panel">
  <% if (!queue.length) { %>
    <p class="db-muted">No pending documents.</p>
  <% } else { %>
    <div class="table-wrap" style="border:0;box-shadow:none;">
      <table class="data">
        <thead>
          <tr>
            <th>Customer</th>
            <th>Email</th>
            <th>Document</th>
            <th>Submitted</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% queue.forEach(function(d) { %>
            <tr>
              <td>
                <%= d.customerReference || '—' %><br>
                <small><%= [d.firstName, d.lastName].filter(Boolean).join(' ') %></small>
              </td>
              <td><%= d.email %></td>
              <td>
                <%= d.documentType %><br>
                <a href="/admin/kyc/documents/<%= d.id %>" target="_blank" rel="noopener">View securely</a>
              </td>
              <td><%= d.createdAt %></td>
              <td>
                <div class="kyc-actions">
                  <a class="btn btn-outline" style="padding:0.35rem 0.65rem;font-size:0.78rem;" href="/admin/kyc/<%= d.id %>/review">Review…</a>
                  <form method="post" action="/admin/kyc/<%= d.id %>/review" class="kyc-inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-navy" name="decision" value="approved" type="submit" style="padding:0.35rem 0.65rem;font-size:0.78rem;">Approve</button>
                  </form>
                  <form method="post" action="/admin/kyc/<%= d.id %>/review" class="kyc-inline-form" onsubmit="return confirm('Reject this document?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="reason" value="Rejected from queue">
                    <button class="btn btn-outline" name="decision" value="rejected" type="submit" style="padding:0.35rem 0.65rem;font-size:0.78rem;border-color:#8B3A3A;color:#8B3A3A;">Reject</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  <p class="db-sandbox-note" style="margin-top:1rem;">Prefer <strong>Review…</strong> when rejecting so you can record a clear reason.</p>
</section>

<%- include('../partials/admin-shell-end') %>