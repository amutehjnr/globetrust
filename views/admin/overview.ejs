<%- include('../partials/admin-shell-start') %>

<% if (message) { %><div class="db-alert" style="background:#d8ead8;color:#1e5c2a;"><%= message %></div><% } %>
<% if (error) { %><div class="db-alert db-alert--err"><%= error %></div><% } %>

<div class="db-greeting">
  <div>
    <h1>Admin overview</h1>
    <p>Operations snapshot for Globe Trust Bank.</p>
  </div>
  <a class="db-promo__btn" href="/admin/customers/new">＋ Create customer</a>
</div>

<div class="db-balance-grid">
  <article class="db-bal-card db-bal-card--total">
    <div class="db-bal-card__label">Users</div>
    <div class="db-bal-card__value"><%= counts.users %></div>
    <div class="db-bal-card__hint">All statuses</div>
  </article>
  <article class="db-bal-card">
    <div class="db-bal-card__label">Pending KYC</div>
    <div class="db-bal-card__value"><%= counts.pendingKyc %></div>
    <div class="db-bal-card__hint"><a href="/admin/kyc">Review queue →</a></div>
  </article>
  <article class="db-bal-card">
    <div class="db-bal-card__label">Open support</div>
    <div class="db-bal-card__value"><%= counts.openSupport || 0 %></div>
    <div class="db-bal-card__hint"><a href="/admin/support">Inbox →</a></div>
  </article>
  <article class="db-bal-card">
    <div class="db-bal-card__label">Transfers (7d)</div>
    <div class="db-bal-card__value"><%= counts.transfersLast7Days || 0 %></div>
    <div class="db-bal-card__hint">Sandbox requests</div>
  </article>
</div>

<div class="db-mid-grid" style="grid-template-columns:1.2fr 1fr;">
  <section class="db-panel">
    <div class="db-panel__head">
      <h2>Registrations (7 days)</h2>
    </div>
    <div class="db-chart" role="img" aria-label="Registrations chart">
      <% 
        var max = 1;
        (registrationsLast7 || []).forEach(function(d) { if (d.count > max) max = d.count; });
        (registrationsLast7 || []).forEach(function(d) { 
          var h = Math.max(8, Math.round((d.count / max) * 100));
      %>
        <div class="db-chart__col">
          <div class="db-chart__bar" style="height:<%= h %>%"></div>
          <span><%= String(d.date).slice(5) %></span>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="db-panel">
    <div class="db-panel__head">
      <h2>Pending KYC</h2>
      <a href="/admin/kyc">View all</a>
    </div>
    <% if (!pendingKycPreview || !pendingKycPreview.length) { %>
      <p class="db-muted">No pending documents.</p>
    <% } else { %>
      <ul class="db-tx-list">
        <% pendingKycPreview.forEach(function(d) { %>
          <li>
            <span class="db-tx-icon">☰</span>
            <div class="db-tx-body">
              <strong><%= d.firstName || '' %> <%= d.lastName || '' %></strong>
              <small><%= d.email %> · <%= d.documentType %></small>
            </div>
            <a class="db-chip" href="/admin/kyc/<%= d.id %>/review">Review</a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<section class="db-panel" style="margin-top:1rem;">
  <div class="db-panel__head">
    <h2>Recent customers</h2>
    <a href="/admin/customers">Search</a>
  </div>
  <div class="table-wrap" style="border:0;box-shadow:none;">
    <table class="data">
      <thead>
        <tr><th>Name</th><th>Email</th><th>Reference</th><th>Status</th><th>Joined</th></tr>
      </thead>
      <tbody>
        <% (recentCustomers || []).forEach(function(c) { %>
          <tr>
            <td><%= c.firstName || '' %> <%= c.lastName || '' %></td>
            <td><%= c.email %></td>
            <td><%= c.customerReference || '—' %></td>
            <td><span class="db-badge db-badge--<%= c.status === 'active' ? 'ok' : 'pending' %>"><%= c.status %></span></td>
            <td><%= c.createdAt %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<%- include('../partials/admin-shell-end') %>