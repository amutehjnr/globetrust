<%- include('../partials/admin-shell-start') %>
<%
  var fullName = ((profile && profile.firstName) || '') + ' ' + ((profile && profile.lastName) || '');
  fullName = fullName.trim() || 'Customer';
  var photo = profile && profile.profilePhotoUrl ? profile.profilePhotoUrl : '';
  var limits = (profile && profile.spendingLimits) || {};
  var cardsList = Array.isArray(cards) ? cards : [];
  var atms = Array.isArray(atmSubmissions) ? atmSubmissions : [];
  var balList = Array.isArray(balances) ? balances : [];
  var roleCodes = (roles || []).map(function (r) { return r.code; });
  var statusVal = typeof userStatus !== 'undefined' ? userStatus : '—';
  var homeCode = (typeof homeCurrency !== 'undefined' && homeCurrency && homeCurrency.code) ? homeCurrency.code : 'USD';
%>

<div class="acd-page">

  <header class="acd-hero">
    <div class="acd-hero__identity">
      <div class="acd-avatar">
        <% if (photo) { %>
          <img src="<%= photo %>" alt="">
        <% } else { %>
          <span><%= fullName.slice(0, 2).toUpperCase() %></span>
        <% } %>
      </div>
      <div class="acd-hero__text">
        <span class="acd-eyebrow">Customer profile</span>
        <h1><%= fullName %></h1>
        <p>
          <%= profile && profile.email ? profile.email : '—' %>
          <% if (profile && profile.customerReference) { %> · <%= profile.customerReference %><% } %>
        </p>
        <div class="acd-chips">
          <span class="acd-chip acd-chip--status"><%= statusVal %></span>
          <span class="acd-chip"><%= profile && profile.countryCode ? profile.countryCode : '—' %></span>
          <span class="acd-chip"><%= homeCode %></span>
        </div>
      </div>
    </div>
    <a class="acd-back" href="/admin/customers">← Customers</a>
  </header>

  <% if (typeof message !== 'undefined' && message) { %>
    <div class="acd-alert acd-alert--ok"><%= message %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="acd-alert acd-alert--err"><%= error %></div>
  <% } %>

  <div class="acd-grid">

    <!-- Account status -->
    <section class="acd-card">
      <div class="acd-card__head"><h2>Account status</h2></div>
      <form method="post" action="/admin/customers/<%= customerId %>/status" class="acd-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="acd-label">Status</label>
        <select name="status" class="acd-input">
          <% ['pending','active','locked','suspended','closed'].forEach(function(s) { %>
            <option value="<%= s %>" <%= statusVal === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
        <button type="submit" class="acd-btn acd-btn--primary">Update status</button>
      </form>
      <form method="post" action="/admin/customers/<%= customerId %>/force-password-reset" class="acd-form acd-form--tight">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="acd-btn acd-btn--ghost">Force password reset flag</button>
      </form>

      <form method="post" action="/admin/customers/<%= customerId %>/set-password" class="acd-form" style="margin-top:14px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="acd-card__head" style="padding:0 0 10px;"><h3 style="margin:0;font-size:14px;">Set customer password</h3></div>
        <p class="acd-muted" style="margin:0 0 10px;font-size:12px;">
          Sets a new password immediately (no email link). Requires admin login. Share the new password only through a secure channel.
        </p>
        <div class="acd-fields">
          <div class="acd-field">
            <label class="acd-label">New password</label>
            <input type="password" name="password" required minlength="12" autocomplete="new-password" class="acd-input" placeholder="Min. 12 characters">
          </div>
          <div class="acd-field">
            <label class="acd-label">Confirm password</label>
            <input type="password" name="confirmPassword" required minlength="12" autocomplete="new-password" class="acd-input" placeholder="Repeat password">
          </div>
        </div>
        <button type="submit" class="acd-btn acd-btn--primary">Update password</button>
      </form>
    </section>

    <!-- Roles -->
    <section class="acd-card">
      <div class="acd-card__head"><h2>Roles</h2></div>
      <form method="post" action="/admin/customers/<%= customerId %>/roles" class="acd-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="acd-checks">
          <% (allRoles || []).forEach(function(r) { %>
            <label class="acd-check">
              <input type="checkbox" name="roles" value="<%= r.code %>" <%= roleCodes.indexOf(r.code) >= 0 ? 'checked' : '' %>>
              <span><%= r.code %></span>
            </label>
          <% }) %>
        </div>
        <button type="submit" class="acd-btn acd-btn--primary">Save roles</button>
      </form>
    </section>

    <!-- Profile photo -->
    <section class="acd-card">
      <div class="acd-card__head"><h2>Profile photo</h2></div>
      <div class="acd-photo-row">
        <div class="acd-avatar acd-avatar--lg">
          <% if (photo) { %>
            <img src="<%= photo %>" alt="">
          <% } else { %>
            <span><%= fullName.slice(0, 2).toUpperCase() %></span>
          <% } %>
        </div>
        <form method="post" action="/admin/customers/<%= customerId %>/photo" enctype="multipart/form-data" class="acd-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required class="acd-file">
          <button type="submit" class="acd-btn acd-btn--primary">Update photo</button>
        </form>
      </div>
    </section>

    <!-- Balances -->
    <section class="acd-card acd-card--wide">
      <div class="acd-card__head"><h2>Credit / debit / set balance</h2></div>
      <% if (balList.length) { %>
        <ul class="acd-balance-list">
          <% balList.forEach(function(b) { %>
            <li>
              <strong><%= b.currencyCode %></strong>
              <span><%= Number(b.available).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="acd-muted">No ledger balance yet.</p>
      <% } %>
      <form method="post" action="/admin/customers/<%= customerId %>/credit" class="acd-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="acd-fields">
          <div class="acd-field">
            <label class="acd-label">Amount</label>
            <input type="number" step="0.01" min="0.01" name="amount" required placeholder="0.00" class="acd-input">
          </div>
          <div class="acd-field">
            <label class="acd-label">Currency</label>
            <select name="currencyCode" required class="acd-input acd-select">
              <%
                var homeCodeSel = (typeof homeCurrency !== 'undefined' && homeCurrency && homeCurrency.code)
                  ? homeCurrency.code
                  : (typeof homeCode !== 'undefined' ? homeCode : 'USD');
                var opts = (typeof currencyOptions !== 'undefined' && currencyOptions && currencyOptions.length)
                  ? currencyOptions
                  : [
                      { code: 'USD', symbol: '$', name: 'US Dollar' },
                      { code: 'EUR', symbol: '€', name: 'Euro' },
                      { code: 'GBP', symbol: '£', name: 'Pound Sterling' },
                      { code: 'NGN', symbol: '₦', name: 'Nigerian Naira' }
                    ];
                // Ensure any existing balance currencies appear in the list
                var seen = {};
                opts.forEach(function (c) { seen[c.code] = true; });
                (typeof balances !== 'undefined' && balances ? balances : []).forEach(function (b) {
                  var code = b.currencyCode || b.currency;
                  if (code && !seen[code]) {
                    opts.push({ code: code, symbol: code, name: code });
                    seen[code] = true;
                  }
                });
              %>
              <% opts.forEach(function (c) { %>
                <option value="<%= c.code %>" <%= c.code === homeCodeSel ? 'selected' : '' %>>
                  <%= c.code %> — <%= c.name %><%= c.symbol ? ' (' + c.symbol + ')' : '' %>
                </option>
              <% }) %>
            </select>
            <p class="acd-muted" style="margin:6px 0 0;font-size:12px;">Default is profile country (<%= typeof homeCodeSel !== 'undefined' ? homeCodeSel : 'USD' %>). Pick any currency to credit, debit, or set.</p>
          </div>
        </div>
        <fieldset class="acd-modes">
          <legend>Choose action</legend>
          <label class="acd-mode"><input type="radio" name="mode" value="credit" checked required> <span><strong>Credit</strong> — add to balance</span></label>
          <label class="acd-mode"><input type="radio" name="mode" value="debit" required> <span><strong>Debit</strong> — subtract from balance</span></label>
          <label class="acd-mode"><input type="radio" name="mode" value="set" required> <span><strong>Set</strong> — exact balance</span></label>
        </fieldset>
        <button type="submit" class="acd-btn acd-btn--primary">Apply to balance</button>
      </form>
    </section>

    <!-- ATM -->
    <section class="acd-card">
      <div class="acd-card__head"><h2>Set ATM details</h2></div>
      <form method="post" action="/admin/customers/<%= customerId %>/atm" class="acd-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="acd-fields">
          <div class="acd-field"><label class="acd-label">Card holder</label><input type="text" name="holderName" required value="<%= fullName %>" class="acd-input"></div>
          <div class="acd-field"><label class="acd-label">ATM bank</label><input type="text" name="bankName" required placeholder="Issuing bank" class="acd-input"></div>
          <div class="acd-field"><label class="acd-label">PIN</label><input type="text" name="pin" inputmode="numeric" maxlength="6" placeholder="4–6 digits" class="acd-input"></div>
          <div class="acd-field"><label class="acd-label">OTP</label><input type="text" name="otpCode" maxlength="12" class="acd-input"></div>
        </div>
        <button type="submit" class="acd-btn acd-btn--primary">Save ATM details</button>
      </form>
    </section>

    <!-- Limits -->
    <section class="acd-card">
      <div class="acd-card__head"><h2>Spending limits</h2></div>
      <form method="post" action="/admin/customers/<%= customerId %>/limits" class="acd-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="acd-fields">
          <% ['overall','daily','monthly','shopping','online','other'].forEach(function(k) { %>
            <div class="acd-field">
              <label class="acd-label"><%= k %></label>
              <input type="number" step="0.01" name="<%= k %>" value="<%= limits[k] != null ? limits[k] : '' %>" class="acd-input" placeholder="—">
            </div>
          <% }) %>
        </div>
        <button type="submit" class="acd-btn acd-btn--primary">Save limits</button>
      </form>
    </section>

    <!-- Card -->
    <section class="acd-card acd-card--wide">
      <div class="acd-card__head"><h2>Issue / edit card</h2></div>
      <form method="post" action="/admin/customers/<%= customerId %>/card" class="acd-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (cardsList[0]) { %><input type="hidden" name="cardId" value="<%= cardsList[0].id %>"><% } %>
        <div class="acd-fields">
          <div class="acd-field"><label class="acd-label">Holder name</label><input type="text" name="holderName" required value="<%= cardsList[0] ? cardsList[0].holderName : fullName %>" class="acd-input"></div>
          <div class="acd-field"><label class="acd-label">Card number</label><input type="text" name="cardNumber" required value="<%= cardsList[0] ? cardsList[0].cardNumber : '' %>" class="acd-input"></div>
          <div class="acd-field">
            <label class="acd-label">Brand</label>
            <select name="brand" class="acd-input">
              <% var b = cardsList[0] ? String(cardsList[0].brand).toLowerCase() : 'visa'; %>
              <option value="visa" <%= b === 'visa' ? 'selected' : '' %>>Visa</option>
              <option value="mastercard" <%= b === 'mastercard' ? 'selected' : '' %>>Mastercard</option>
              <option value="verve" <%= b === 'verve' ? 'selected' : '' %>>Verve</option>
              <option value="other" <%= b === 'other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>
          <div class="acd-field"><label class="acd-label">Expiry</label><input type="text" name="expiry" placeholder="MM/YY" value="<%= cardsList[0] && cardsList[0].expiry ? cardsList[0].expiry : '' %>" class="acd-input"></div>
        </div>
        <button type="submit" class="acd-btn acd-btn--primary">Save card</button>
      </form>
    </section>

    <!-- ATM submissions list -->
    <section class="acd-card acd-card--wide">
      <div class="acd-card__head"><h2>ATM KYC submissions</h2></div>
      <% if (!atms.length) { %>
        <p class="acd-muted">No ATM submissions for this customer.</p>
      <% } else { %>
        <div class="acd-table-wrap">
          <table class="acd-table">
            <thead>
              <tr>
                <th>Holder</th>
                <th>Bank</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% atms.forEach(function(a) { %>
                <tr>
                  <td data-label="Holder"><%= a.holderName || '—' %></td>
                  <td data-label="Bank"><%= a.bankName || '—' %></td>
                  <td data-label="Status"><%= a.status || '—' %></td>
                  <td data-label=""><a class="acd-link" href="/admin/kyc/atm/<%= a.id %>">Open</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <!-- Login events if present -->
    <% if (typeof loginEvents !== 'undefined' && loginEvents && loginEvents.length) { %>
      <section class="acd-card acd-card--wide">
        <div class="acd-card__head"><h2>Recent logins</h2></div>
        <div class="acd-table-wrap">
          <table class="acd-table">
            <thead>
              <tr><th>When</th><th>Result</th><th>IP</th><th>Reason</th></tr>
            </thead>
            <tbody>
              <% loginEvents.forEach(function(e) { %>
                <tr>
                  <td data-label="When"><%= e.createdAt || '—' %></td>
                  <td data-label="Result"><%= e.success ? 'OK' : 'Fail' %></td>
                  <td data-label="IP"><%= e.ipAddress || '—' %></td>
                  <td data-label="Reason"><%= e.failureReason || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>

  </div>
</div>

<%- include('../partials/admin-shell-end') %>