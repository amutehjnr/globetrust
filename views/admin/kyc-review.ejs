<%- include('../partials/admin-shell-start') %>

<p><a href="/admin/kyc">← Back to queue</a></p>
<div class="db-greeting">
  <div>
    <h1>Review identity document</h1>
  </div>
</div>

<% if (error) { %><div class="db-alert db-alert--err"><%= error %></div><% } %>

<section class="db-panel" style="max-width:36rem;margin-bottom:1.25rem;">
  <p><strong>Document type:</strong> <%= doc.documentType %></p>
  <p><strong>Status:</strong>
    <span class="db-badge db-badge--<%= doc.verificationStatus === 'pending' ? 'pending' : doc.verificationStatus === 'approved' ? 'ok' : 'err' %>">
      <%= doc.verificationStatus %>
    </span>
  </p>
  <p><strong>Submitted:</strong> <%= doc.createdAt %></p>
  <p><strong>Storage:</strong> <%= doc.storageProvider %></p>
  <p>
    <a class="btn btn-outline" href="/admin/kyc/documents/<%= doc.id %>" target="_blank" rel="noopener">View document securely</a>
  </p>
</section>

<% if (doc.verificationStatus === 'pending') { %>
  <section class="db-panel" style="max-width:36rem;">
    <form method="post" action="/admin/kyc/<%= doc.id %>/review" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label for="reason">Reason (required for rejection)</label>
        <textarea id="reason" name="reason" rows="3" maxlength="500" placeholder="e.g. Image blurred, document expired…"></textarea>
      </div>
      <div class="quick-actions">
        <button class="btn btn-navy" type="submit" name="decision" value="approved">Approve</button>
        <button class="btn btn-outline" type="submit" name="decision" value="rejected" style="border-color:#8B3A3A;color:#8B3A3A;">Reject</button>
      </div>
    </form>
  </section>
<% } else { %>
  <div class="db-alert" style="background:var(--db-ivory);">This document is already <strong><%= doc.verificationStatus %></strong>.</div>
<% } %>

<%- include('../partials/admin-shell-end') %>