<%- include('../partials/admin-shell-start') %>

<div class="db-greeting">
  <div>
    <h1>Support inbox</h1>
    <p>Open and waiting conversations.</p>
  </div>
</div>

<section class="db-panel">
  <% if (!queue || !queue.length) { %>
    <p class="db-muted">No open conversations.</p>
  <% } else { %>
    <ul class="db-tx-list">
      <% queue.forEach(function(c) { %>
        <li>
          <span class="db-tx-icon">◇</span>
          <div class="db-tx-body">
            <strong><%= c.subject || 'Conversation' %></strong>
            <small><%= c.status %> · <%= c.updatedAt || c.createdAt || '' %></small>
          </div>
          <a class="db-chip" href="/admin/support/<%= c.id %>">Open</a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%- include('../partials/admin-shell-end') %>