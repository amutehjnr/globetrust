<%- include('../partials/admin-shell-start') %>

<div class="db-greeting">
  <div>
    <h1>Customers</h1>
    <p>Search by email, name, or reference. Filter by status, country, KYC.</p>
  </div>
  <a class="db-promo__btn" href="/admin/customers/new">
    <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" style="width:14px;height:14px;">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
    Create account
  </a>
</div>

<%
  var customerResults = Array.isArray(results) ? results : [];
  var searchQuery = typeof q === 'string' ? q : '';
  var total = customerResults.length;
  var active = 0;
  var pending = 0;
  var other = 0;
  customerResults.forEach(function(c) {
    var s = String(c.status || '').toLowerCase();
    if (s === 'active') active++;
    else if (s === 'pending') pending++;
    else other++;
  });
%>

<section class="cust-toolbar">
  <form method="get" action="/admin/customers" class="cust-search-form" role="search" style="flex-wrap:wrap;gap:8px;">
    <div class="cust-search">
      <input
        type="search"
        name="q"
        value="<%= q || '' %>"
        placeholder="Search by email, name, or reference…"
        aria-label="Search customers"
        autocomplete="off"
      >
    </div>
    <select name="status" aria-label="Status">
      <option value="">All statuses</option>
      <% ['pending','active','locked','suspended','closed'].forEach(function(s) { %>
        <option value="<%= s %>" <%= (typeof status !== 'undefined' && status === s) ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
    <input
      type="text"
      name="country"
      maxlength="2"
      placeholder="CC"
      value="<%= typeof country !== 'undefined' ? country : '' %>"
      style="width:70px;"
      aria-label="Country code"
    >
    <select name="kyc" aria-label="KYC status">
      <option value="">Any KYC</option>
      <% ['pending','approved','rejected'].forEach(function(s) { %>
        <option value="<%= s %>" <%= (typeof kyc !== 'undefined' && kyc === s) ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
    <button type="submit" class="cust-search-btn">Search</button>
    <% if (q || status || country || kyc) { %>
      <a href="/admin/customers" class="cust-search-clear">Clear</a>
    <% } %>
  </form>
</section>

<% if (total > 0) { %>
  <section class="cust-summary">
    <div class="cust-summary-item">
      <span class="cust-summary-label">Total</span>
      <strong class="cust-summary-value"><%= total %></strong>
    </div>
    <div class="cust-summary-item">
      <span class="cust-summary-label">Active</span>
      <strong class="cust-summary-value cust-summary-value-ok"><%= active %></strong>
    </div>
    <div class="cust-summary-item">
      <span class="cust-summary-label">Pending</span>
      <strong class="cust-summary-value cust-summary-value-warn"><%= pending %></strong>
    </div>
  </section>
<% } %>

<section class="db-panel cust-panel">
  <div class="cust-panel-head">
    <h2>Customer list</h2>
    <span class="cust-panel-count"><%= total %> shown</span>
  </div>

  <% if (!results || !results.length) { %>
    <div class="cust-empty">
      <h3>No customers match</h3>
      <p>Try different filters or create a customer.</p>
      <a href="/admin/customers/new" class="cust-empty-btn">Create customer</a>
    </div>
  <% } else { %>
    <div class="cust-table-wrap">
      <table class="cust-table">
        <thead>
          <tr>
            <th>Customer</th>
            <th>Email</th>
            <th>Reference</th>
            <th>Country</th>
            <th>Status</th>
            <th>Joined</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% results.forEach(function(c) { %>
            <%
              var fn = c.firstName || '';
              var ln = c.lastName || '';
              var fullName = (fn + ' ' + ln).trim() || 'Unnamed customer';
              var initials = ((fn[0] || '') + (ln[0] || '')).toUpperCase() || (c.email ? c.email[0].toUpperCase() : '?');
              var st = String(c.status || '').toLowerCase();
              var statusClass = st === 'active' ? 'ok' : st === 'pending' ? 'pending' : 'other';
              var statusLabel = c.status ? c.status.charAt(0).toUpperCase() + c.status.slice(1) : 'Unknown';
            %>
            <tr>
              <td>
                <div class="cust-customer">
                  <span class="cust-avatar"><%= initials %></span>
                  <span class="cust-customer-name"><%= fullName %></span>
                </div>
              </td>
              <td><a href="mailto:<%= c.email %>" class="cust-email"><%= c.email %></a></td>
              <td>
                <% if (c.customerReference) { %>
                  <code class="cust-ref"><%= c.customerReference %></code>
                <% } else { %>—<% } %>
              </td>
              <td><%= c.countryCode || '—' %></td>
              <td>
                <span class="cust-badge cust-badge-<%= statusClass %>">
                  <span class="cust-badge-dot"></span>
                  <%= statusLabel %>
                </span>
              </td>
              <td class="cust-cell-date">
                <%= c.createdAt ? String(c.createdAt).split('T')[0] || c.createdAt : '—' %>
              </td>
              <td>
                <a href="/admin/customers/<%= c.id %>" class="cust-row-action" title="View">→</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/admin-shell-end') %>