<%- include('../partials/admin-shell-start') %>

<div class="db-greeting cust-greeting">
  <div>
    <h1>Customers</h1>
    <p>Search by email, name, or reference. Filter by status, country, KYC.</p>
  </div>
  <a class="db-promo__btn cust-create-btn" href="/admin/customers/new">
    <span aria-hidden="true">＋</span> Create account
  </a>
</div>

<%
  var customerResults = Array.isArray(results) ? results : [];
  var qVal = typeof q !== 'undefined' && q ? q : '';
  var statusVal = typeof status !== 'undefined' && status ? status : '';
  var countryVal = typeof country !== 'undefined' && country ? country : '';
  var kycVal = typeof kyc !== 'undefined' && kyc ? kyc : '';
  var total = customerResults.length;
  var active = 0;
  var pending = 0;
  customerResults.forEach(function(c) {
    var s = String(c.status || '').toLowerCase();
    if (s === 'active') active++;
    else if (s === 'pending') pending++;
  });
%>

<section class="cust-toolbar">
  <form method="get" action="/admin/customers" class="cust-search-form" role="search">
    <div class="cust-search">
      <span class="cust-search-icon" aria-hidden="true">⌕</span>
      <input type="search" name="q" value="<%= qVal %>" placeholder="Search email, name, or reference…" autocomplete="off">
    </div>
    <div class="cust-filters">
      <select name="status" aria-label="Status" class="cust-select">
        <option value="">All statuses</option>
        <% ['pending','active','locked','suspended','closed'].forEach(function(s) { %>
          <option value="<%= s %>" <%= statusVal === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
      <input type="text" name="country" maxlength="2" placeholder="CC" value="<%= countryVal %>" class="cust-country" aria-label="Country code">
      <select name="kyc" aria-label="KYC status" class="cust-select">
        <option value="">Any KYC</option>
        <% ['pending','approved','rejected'].forEach(function(s) { %>
          <option value="<%= s %>" <%= kycVal === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
      <button type="submit" class="cust-search-btn">Search</button>
      <% if (qVal || statusVal || countryVal || kycVal) { %>
        <a href="/admin/customers" class="cust-search-clear">Clear</a>
      <% } %>
    </div>
  </form>
</section>

<% if (total > 0) { %>
  <section class="cust-summary" aria-label="Result summary">
    <div class="cust-summary-item">
      <span class="cust-summary-label">Total</span>
      <strong class="cust-summary-value"><%= total %></strong>
    </div>
    <div class="cust-summary-item">
      <span class="cust-summary-label">Active</span>
      <strong class="cust-summary-value cust-summary-value-ok"><%= active %></strong>
    </div>
    <div class="cust-summary-item">
      <span class="cust-summary-label">Pending</span>
      <strong class="cust-summary-value cust-summary-value-warn"><%= pending %></strong>
    </div>
  </section>
<% } %>

<section class="db-panel cust-panel">
  <div class="cust-panel-head">
    <h2>Customer list</h2>
    <span class="cust-panel-count"><%= total %> shown</span>
  </div>

  <% if (!customerResults.length) { %>
    <div class="cust-empty">
      <div class="cust-empty-icon" aria-hidden="true">▤</div>
      <h3>No customers match</h3>
      <p>Try different filters or create a new customer account.</p>
      <a href="/admin/customers/new" class="cust-empty-btn">Create customer</a>
    </div>
  <% } else { %>

    <div class="cust-table-wrap">
      <table class="cust-table">
        <thead>
          <tr>
            <th>Customer</th>
            <th>Email</th>
            <th>Reference</th>
            <th>Country</th>
            <th>Status</th>
            <th>Joined</th>
            <th class="cust-table-actions-col"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% customerResults.forEach(function(c) { %>
            <%
              var fn = c.firstName || '';
              var ln = c.lastName || '';
              var fullName = (fn + ' ' + ln).trim() || 'Unnamed customer';
              var initials = ((fn[0] || '') + (ln[0] || '')).toUpperCase() || (c.email ? c.email[0].toUpperCase() : '?');
              var st = String(c.status || '').toLowerCase();
              var statusClass = st === 'active' ? 'ok' : st === 'pending' ? 'pending' : 'other';
              var statusLabel = c.status ? c.status.charAt(0).toUpperCase() + c.status.slice(1) : 'Unknown';
              var joined = c.createdAt ? String(c.createdAt).split('T')[0] || c.createdAt : '—';
            %>
            <tr>
              <td>
                <div class="cust-customer">
                  <span class="cust-avatar"><%= initials %></span>
                  <span class="cust-customer-name"><%= fullName %></span>
                </div>
              </td>
              <td><a href="mailto:<%= c.email %>" class="cust-email"><%= c.email %></a></td>
              <td><% if (c.customerReference) { %><code class="cust-ref"><%= c.customerReference %></code><% } else { %><span class="cust-muted">—</span><% } %></td>
              <td><%= c.countryCode || '—' %></td>
              <td>
                <span class="cust-badge cust-badge-<%= statusClass %>">
                  <span class="cust-badge-dot"></span>
                  <%= statusLabel %>
                </span>
              </td>
              <td class="cust-cell-date"><%= joined %></td>
              <td class="cust-cell-actions">
                <a href="/admin/customers/<%= c.id %>" class="cust-row-action" title="View customer">View</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="cust-cards" aria-label="Customers">
      <% customerResults.forEach(function(c) { %>
        <%
          var fn = c.firstName || '';
          var ln = c.lastName || '';
          var fullName = (fn + ' ' + ln).trim() || 'Unnamed customer';
          var initials = ((fn[0] || '') + (ln[0] || '')).toUpperCase() || (c.email ? c.email[0].toUpperCase() : '?');
          var st = String(c.status || '').toLowerCase();
          var statusClass = st === 'active' ? 'ok' : st === 'pending' ? 'pending' : 'other';
          var statusLabel = c.status ? c.status.charAt(0).toUpperCase() + c.status.slice(1) : 'Unknown';
          var joined = c.createdAt ? String(c.createdAt).split('T')[0] || c.createdAt : '—';
        %>
        <a class="cust-card" href="/admin/customers/<%= c.id %>">
          <div class="cust-card-top">
            <span class="cust-avatar"><%= initials %></span>
            <div class="cust-card-id">
              <strong><%= fullName %></strong>
              <span><%= c.email %></span>
            </div>
            <span class="cust-badge cust-badge-<%= statusClass %>">
              <span class="cust-badge-dot"></span>
              <%= statusLabel %>
            </span>
          </div>
          <div class="cust-card-meta">
            <span><% if (c.customerReference) { %><code class="cust-ref"><%= c.customerReference %></code><% } else { %>—<% } %></span>
            <span><%= c.countryCode || '—' %></span>
            <span><%= joined %></span>
          </div>
        </a>
      <% }) %>
    </div>

  <% } %>
</section>

<%- include('../partials/admin-shell-end') %>