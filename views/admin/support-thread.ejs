<%- include('../partials/admin-shell-start') %>

<%
  var statusRaw = (conversation.status || 'open').toLowerCase();
  var statusLabel = statusRaw.charAt(0).toUpperCase() + statusRaw.slice(1);
  var fn = conversation.firstName || '';
  var ln = conversation.lastName || '';
  var custName = (fn + ' ' + ln).trim() || conversation.customerName || (conversation.customerEmail || conversation.email || 'Customer');
  var initials = ((fn[0] || '') + (ln[0] || '')).toUpperCase();
  if (!initials) {
    var parts = String(custName).split(/\s+/);
    if (parts.length >= 2) initials = (parts[0][0] + parts[1][0]).toUpperCase();
    else initials = String(custName).slice(0, 2).toUpperCase();
  }
  var custEmail = conversation.customerEmail || conversation.email || '';
  var custRef = conversation.customerReference || '';
  var msgCount = messages ? messages.length : 0;
%>

<div class="ast">
  <!-- Top bar -->
  <header class="ast-top">
    <a href="/admin/support" class="ast-back" title="Back to inbox">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
      </svg>
      <span>Inbox</span>
    </a>

    <div class="ast-top-main">
      <div class="ast-top-customer">
        <div class="ast-avatar" aria-hidden="true"><%= initials %></div>
        <div class="ast-top-text">
          <h1 class="ast-title"><%= custName %></h1>
          <div class="ast-sub">
            <span class="ast-pill ast-pill-<%= statusRaw %>">
              <span class="ast-pill-dot"></span>
              <%= statusLabel %>
            </span>
            <% if (custEmail) { %>
              <span class="ast-dot-sep"></span>
              <a class="ast-email" href="mailto:<%= custEmail %>"><%= custEmail %></a>
            <% } %>
            <span class="ast-dot-sep"></span>
            <span class="ast-muted"><%= msgCount %> message<%= msgCount === 1 ? '' : 's' %></span>
          </div>
        </div>
      </div>
    </div>

    <div class="ast-top-actions">
      <form method="post" action="/admin/support/<%= conversation.id %>/close" class="ast-close-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="ast-btn ast-btn-ghost" <%= statusRaw === 'closed' ? 'disabled' : '' %>>
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Close</span>
        </button>
      </form>
    </div>
  </header>

  <div class="ast-body">
    <!-- Chat column -->
    <section class="ast-chat">
      <div
        id="chat-log"
        class="ast-log"
        data-conversation="<%= conversation.id %>"
        data-user="<%= userId %>"
      >
        <% if (!messages || !messages.length) { %>
          <div class="ast-empty">
            <div class="ast-empty-icon">
              <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
              </svg>
            </div>
            <h3>No messages yet</h3>
            <p>Send the first reply to start helping this customer.</p>
          </div>
        <% } %>

        <% (messages || []).forEach(function(m) {
          var mine = m.senderUserId === userId;
          var isImg = m.type === 'image' || (m.attachmentMime && String(m.attachmentMime).indexOf('image/') === 0);
        %>
          <div class="ast-msg <%= mine ? 'ast-msg--me' : 'ast-msg--them' %>">
            <% if (!mine) { %>
              <div class="ast-msg-avatar" aria-hidden="true"><%= initials %></div>
            <% } %>
            <div class="ast-bubble">
              <% if (m.attachmentUrl && isImg) { %>
                <a href="<%= m.attachmentUrl %>" target="_blank" rel="noopener noreferrer" class="ast-attach-img-wrap">
                  <img class="ast-attach-img" src="<%= m.attachmentUrl %>" alt="<%= m.attachmentName || 'Image' %>">
                </a>
                <% if (m.text && m.text !== m.attachmentName) { %>
                  <div class="ast-attach-caption"><%= m.text %></div>
                <% } %>
              <% } else if (m.attachmentUrl) { %>
                <a class="ast-attach-file" href="<%= m.attachmentUrl %>" target="_blank" rel="noopener noreferrer">
                  <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                  </svg>
                  <span><%= m.attachmentName || 'Download file' %></span>
                </a>
                <% if (m.text && m.text !== m.attachmentName) { %>
                  <div class="ast-attach-caption"><%= m.text %></div>
                <% } %>
              <% } else { %>
                <div class="ast-bubble-text"><%= m.text %></div>
              <% } %>
              <% if (m.createdAt) { %>
                <time class="ast-time"><%= m.createdAt %></time>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="ast-composer-wrap">
        <form
          id="chat-form"
          method="post"
          action="/admin/support/<%= conversation.id %>/messages"
          class="ast-composer"
          autocomplete="off"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <textarea
            name="text"
            id="chat-input"
            required
            maxlength="2000"
            rows="1"
            placeholder="Write a reply…"
            autocomplete="off"
          ></textarea>
          <button class="ast-send" type="submit" aria-label="Send message">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
            </svg>
            <span>Send</span>
          </button>
        </form>
        <p id="socket-status" class="ast-status">
          <span class="ast-status-dot"></span>
          <span class="ast-status-text">Connecting…</span>
        </p>
      </div>
    </section>

    <!-- Sidebar -->
    <aside class="ast-side">
      <div class="ast-card">
        <h3>Customer</h3>
        <div class="ast-customer-row">
          <div class="ast-avatar ast-avatar-lg"><%= initials %></div>
          <div>
            <strong class="ast-customer-name"><%= custName %></strong>
            <% if (custEmail) { %>
              <a class="ast-email" href="mailto:<%= custEmail %>"><%= custEmail %></a>
            <% } %>
          </div>
        </div>
        <dl class="ast-meta-list">
          <% if (custRef) { %>
            <div><dt>Reference</dt><dd><%= custRef %></dd></div>
          <% } %>
          <% if (conversation.createdAt) { %>
            <div><dt>Opened</dt><dd><%= conversation.createdAt %></dd></div>
          <% } %>
          <div><dt>Status</dt><dd><%= statusLabel %></dd></div>
          <div><dt>Messages</dt><dd><%= msgCount %></dd></div>
        </dl>
        <% if (conversation.customerUserId) { %>
          <a class="ast-link-btn" href="/admin/customers/<%= conversation.customerUserId %>">View customer profile</a>
        <% } %>
      </div>

      <div class="ast-card">
        <h3>Quick replies</h3>
        <p class="ast-hint">Tap to insert into your reply.</p>
        <div class="ast-quick">
          <button type="button" class="ast-quick-btn" data-quick="Thanks for getting in touch. Could you share a bit more detail about what you're seeing?">Ask for details</button>
          <button type="button" class="ast-quick-btn" data-quick="We've received your request and will get back to you within one business day.">Acknowledge</button>
          <button type="button" class="ast-quick-btn" data-quick="Could you please share a screenshot so we can investigate further?">Request screenshot</button>
          <button type="button" class="ast-quick-btn" data-quick="This has been escalated to our specialist team. They'll be in touch shortly.">Escalate</button>
          <button type="button" class="ast-quick-btn" data-quick="I'm glad we could help. Let us know if you need anything else — we're here 24/7.">Closing thanks</button>
        </div>
      </div>
    </aside>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/admin-support-chat.js" defer></script>
<script>
  (function () {
    var input = document.getElementById('chat-input');
    if (!input) return;
    function autoresize() {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 140) + 'px';
    }
    input.addEventListener('input', autoresize);
    // Enter sends, Shift+Enter newline
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        var form = document.getElementById('chat-form');
        if (form) form.requestSubmit ? form.requestSubmit() : form.submit();
      }
    });
  })();
</script>

<%- include('../partials/admin-shell-end') %>