<%- include('../partials/admin-shell-start') %>

<p><a href="/admin/support">← Inbox</a></p>
<div class="db-greeting">
  <div>
    <h1><%= conversation.subject || 'Conversation' %></h1>
  </div>
</div>

<section class="db-panel">
  <div id="chat-log" class="chat-log" data-conversation="<%= conversation.id %>" data-user="<%= userId %>">
    <% messages.forEach(function(m) { %>
      <div class="msg <%= m.senderUserId === userId ? 'me' : '' %>">
        <div class="bubble"><%= m.text %></div>
      </div>
    <% }) %>
  </div>
  <form id="chat-form" method="post" action="/admin/support/<%= conversation.id %>/messages" class="form-grid" style="margin-top:1rem;grid-template-columns:1fr auto;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input name="text" id="chat-input" required maxlength="2000" placeholder="Reply as agent">
    <button class="btn btn-navy" type="submit">Send</button>
  </form>
  <p id="socket-status" class="db-muted" style="margin-top:0.5rem;">Connecting…</p>
</section>

<style>
  .chat-log { background:var(--db-ivory,#f6f3ec); border:1px solid var(--db-border,rgba(15,31,51,.08)); border-radius:12px; padding:1rem; min-height:280px; max-height:420px; overflow-y:auto; }
  .msg { margin-bottom:0.75rem; max-width:85%; }
  .msg.me { margin-left:auto; text-align:right; }
  .msg .bubble { display:inline-block; padding:0.55rem 0.85rem; border-radius:12px; background:#e8e2d6; text-align:left; }
  .msg.me .bubble { background:#0f1f33; color:#fffdf9; }
</style>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/support-chat.js" defer></script>

<%- include('../partials/admin-shell-end') %>