<%- include('../../partials/admin-shell-start') %>

<div class="adm-chat-header">
  <a href="/admin/support" class="adm-chat-back">
    <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
    </svg>
    Inbox
  </a>

  <div class="adm-chat-title">
    <h1><%= conversation.subject || 'Conversation' %></h1>
    <div class="adm-chat-meta">
      <span class="adm-chat-status adm-chat-status-<%= (conversation.status || 'open').toLowerCase() %>">
        <span class="adm-chat-status-dot"></span>
        <%= (conversation.status || 'open').charAt(0).toUpperCase() + (conversation.status || 'open').slice(1) %>
      </span>
      <% if (conversation.createdAt) { %>
        <span class="adm-chat-sep">·</span>
        <span>Opened <%= conversation.createdAt %></span>
      <% } %>
    </div>
  </div>

  <div class="adm-chat-actions">
    <form method="post" action="/admin/support/<%= conversation.id %>/close" class="adm-chat-action-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="adm-chat-btn adm-chat-btn-ghost">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Close conversation
      </button>
    </form>
  </div>
</div>

<div class="adm-chat-layout">

  <!-- ========== MAIN: CHAT ========== -->
  <section class="adm-chat-main">
    <div
      id="chat-log"
      class="chat-log"
      data-conversation="<%= conversation.id %>"
      data-user="<%= userId %>"
    >
      <% if (!messages || !messages.length) { %>
        <div class="chat-empty">
          <div class="chat-empty-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
            </svg>
          </div>
          <h3>No messages yet</h3>
          <p>Send the first reply to start the conversation.</p>
        </div>
      <% } %>
      <% messages.forEach(function(m) { %>
        <div class="msg <%= m.senderUserId === userId ? 'me' : '' %>">
          <div class="bubble"><%= m.text %></div>
        </div>
      <% }) %>
    </div>

    <form
      id="chat-form"
      method="post"
      action="/admin/support/<%= conversation.id %>/messages"
      class="chat-composer"
      autocomplete="off"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input
        name="text"
        id="chat-input"
        required
        maxlength="2000"
        placeholder="Reply as agent…"
        autocomplete="off"
      >
      <button class="chat-send" type="submit" aria-label="Send message">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
        </svg>
        <span>Send</span>
      </button>
    </form>

    <p id="socket-status" class="chat-status">
      <span class="chat-status-dot"></span>
      <span class="chat-status-text">Connecting…</span>
    </p>
  </section>

  <!-- ========== SIDEBAR: CONTEXT ========== -->
  <aside class="adm-chat-sidebar">

    <!-- Customer card -->
    <div class="adm-chat-side-card">
      <h3>Customer</h3>
      <%
        var fn = conversation.firstName || '';
        var ln = conversation.lastName || '';
        var custName = (fn + ' ' + ln).trim() || conversation.customerName || (conversation.customerEmail || conversation.email || 'Customer');
        var initials = ((fn[0] || '') + (ln[0] || '')).toUpperCase();
        if (!initials) {
          var parts = custName.split(/\s+/);
          if (parts.length >= 2) initials = (parts[0][0] + parts[1][0]).toUpperCase();
          else initials = custName.slice(0, 2).toUpperCase();
        }
        var custEmail = conversation.customerEmail || conversation.email || '';
        var custRef = conversation.customerReference || '';
      %>
      <div class="adm-chat-customer">
        <div class="adm-chat-avatar"><%= initials %></div>
        <div class="adm-chat-customer-info">
          <strong><%= custName %></strong>
          <% if (custEmail) { %>
            <a href="mailto:<%= custEmail %>" class="adm-chat-email"><%= custEmail %></a>
          <% } %>
          <% if (custRef) { %>
            <span class="adm-chat-ref">Ref: <code><%= custRef %></code></span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Conversation details -->
    <div class="adm-chat-side-card">
      <h3>Conversation</h3>
      <dl class="adm-chat-dl">
        <div>
          <dt>Status</dt>
          <dd>
            <span class="adm-chat-status adm-chat-status-<%= (conversation.status || 'open').toLowerCase() %>">
              <span class="adm-chat-status-dot"></span>
              <%= (conversation.status || 'open').charAt(0).toUpperCase() + (conversation.status || 'open').slice(1) %>
            </span>
          </dd>
        </div>
        <% if (conversation.createdAt) { %>
          <div>
            <dt>Opened</dt>
            <dd><%= conversation.createdAt %></dd>
          </div>
        <% } %>
        <% if (conversation.updatedAt) { %>
          <div>
            <dt>Last activity</dt>
            <dd><%= conversation.updatedAt %></dd>
          </div>
        <% } %>
        <div>
          <dt>Messages</dt>
          <dd><%= messages ? messages.length : 0 %></dd>
        </div>
      </dl>
    </div>

    <!-- Quick replies -->
    <div class="adm-chat-side-card">
      <h3>Quick replies</h3>
      <p class="adm-chat-side-hint">Click to insert into the reply box.</p>
      <div class="adm-chat-quick">
        <button type="button" class="adm-chat-quick-btn" data-quick="Thanks for getting in touch. Could you share a bit more detail about what you're seeing?">
          Ask for details
        </button>
        <button type="button" class="adm-chat-quick-btn" data-quick="We've received your request and will get back to you within one business day.">
          Acknowledge request
        </button>
        <button type="button" class="adm-chat-quick-btn" data-quick="Could you please share a screenshot so we can investigate further?">
          Request screenshot
        </button>
        <button type="button" class="adm-chat-quick-btn" data-quick="This has been escalated to our specialist team. They'll be in touch shortly.">
          Escalate
        </button>
        <button type="button" class="adm-chat-quick-btn" data-quick="I'm glad we could help. Let us know if you need anything else — we're here 24/7.">
          Closing — thanks
        </button>
      </div>
    </div>

  </aside>

</div>

<!-- ========== SCRIPT ========== -->
<script src="/socket.io/socket.io.js"></script>
<script src="/js/support-chat.js" defer></script>
<script>
  (function () {
    /* Quick replies — insert into the chat input */
    var input = document.getElementById('chat-input');
    document.querySelectorAll('[data-quick]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!input) return;
        var text = btn.getAttribute('data-quick') || '';
        if (input.value.trim()) {
          input.value = input.value.trim() + '\n\n' + text;
        } else {
          input.value = text;
        }
        input.focus();
        /* Move cursor to end */
        input.selectionStart = input.selectionEnd = input.value.length;
      });
    });
  })();
</script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/support-chat.js" defer></script>
<script src="/js/admin-support-chat.js" defer></script>

<%- include('../../partials/admin-shell-end') %>

<%- include('../../partials/admin-shell-end') %>