<%- include('../partials/admin-shell-start') %>

<div class="db-greeting">
  <div>
    <h1>Reports</h1>
    <p>Operations snapshot.</p>
  </div>
</div>

<section class="adm-kpi-grid">
  <article class="adm-kpi-card">
    <span class="adm-kpi-label">Registrations today</span>
    <strong class="adm-kpi-value"><%= report.registrationsToday %></strong>
  </article>
  <article class="adm-kpi-card">
    <span class="adm-kpi-label">Registrations (7d)</span>
    <strong class="adm-kpi-value"><%= report.registrations7d %></strong>
  </article>
  <article class="adm-kpi-card">
    <span class="adm-kpi-label">Transfers (7d)</span>
    <strong class="adm-kpi-value"><%= report.transfers7d %></strong>
  </article>
  <article class="adm-kpi-card">
    <span class="adm-kpi-label">Volume (7d)</span>
    <strong class="adm-kpi-value"><%= report.transferVolume7d %></strong>
  </article>
  <article class="adm-kpi-card">
    <span class="adm-kpi-label">KYC pending</span>
    <strong class="adm-kpi-value"><%= report.kycPending %></strong>
  </article>
  <article class="adm-kpi-card">
    <span class="adm-kpi-label">KYC approved (7d)</span>
    <strong class="adm-kpi-value"><%= report.kycApproved7d %></strong>
  </article>
</section>

<section class="db-panel" style="margin-top:16px;">
  <div class="adm-panel-head">
    <div>
      <h2>Transfers by status (7d)</h2>
    </div>
  </div>
  <% var tbs = report.transfersByStatus || {}; %>
  <% if (!Object.keys(tbs).length) { %>
    <p class="db-muted">No transfer data.</p>
  <% } else { %>
    <ul class="kyc-doc-list">
      <% Object.keys(tbs).forEach(function(k) { %>
        <li><strong><%= k %></strong> <span><%= tbs[k] %></span></li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="db-panel" style="margin-top:16px;">
  <div class="adm-panel-head">
    <div>
      <h2>Daily registrations</h2>
      <p>Last ~14 days</p>
    </div>
  </div>
  <% var days = report.registrationsDaily || []; %>
  <% if (!days.length) { %>
    <p class="db-muted">No registration data.</p>
  <% } else { %>
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead><tr><th>Date</th><th>Count</th></tr></thead>
        <tbody>
          <% days.forEach(function(d) { %>
            <tr>
              <td><%= d.date %></td>
              <td><%= d.count %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/admin-shell-end') %>